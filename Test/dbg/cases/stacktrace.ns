// StackTrace() from a break loop two function calls deep. Frames from the
// bottom: 0 the script, 1 Outer, 2 Inner (with its arg), 3 BreakLoop,
// 4 the typed command, 5 StackTrace itself.
global Inner(x)
begin
  BreakLoop();
  x + 1;
end;

global Outer(y)
begin
  Inner(y * 2);
end;

Print(Outer(20));
