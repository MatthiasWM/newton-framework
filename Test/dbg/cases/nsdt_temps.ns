// Step 3.1b: GetTempVar(level, n), SetTempVar(level, n, value),
// GetAllTempVars(level). A breakpoint at pc 10 of Work stops in the middle
// of its last statement, when "result: " and t (42) are on the stack.
// Temporaries count from the top: 0 is t, 1 is "result: ". GetAllTempVars
// ends with 'bottom. Setting temp 0 to 99 changes the result.
// -dbg compiles with variable names (DebuggerInfo, like NTK's "Compile for
// debugging"), so GetNamedVar finds Work's local t by name: 42.
global Work(a)
begin
  local t := a * 2;
  "result: " & t & " " & a;
end;

NSDInstallBreakPoints({programCounter: [
  {instructions: functions.Work.instructions, programCounter: 10, temporary: true}]});
NSDEnableBreakPoints(true);
Print(Work(21));
