// Step 3.1b: GetCurrentReceiver(level) and GetCurrentImplementor(level).
// Tick (level 0) is inherited by obj from base: receiver obj, implementor
// base. Run (level 1) is obj's own method: receiver and implementor obj.
base := {Tick: func(n) begin BreakLoop(); count := count + n; end};
obj := {_proto: base, count: 1, Run: func() :Tick(5)};
obj:Run();
Print(obj.count);
