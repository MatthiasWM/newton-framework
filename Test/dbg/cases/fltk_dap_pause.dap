{"command": "initialize", "arguments": {"clientID": "test", "adapterID": "newtonscript"}}
wait initialized
{"command": "launch", "arguments": {"program": "$PROGRAM"}}
{"command": "configurationDone"}
wait output
{"command": "pause", "arguments": {"threadId": 1}}
{"command": "evaluate", "arguments": {"expression": "TestWindowClick()", "context": "repl"}}
wait stopped
{"command": "stackTrace", "arguments": {"threadId": 1, "levels": 1}}
{"command": "next", "arguments": {"threadId": 1}}
wait stopped
{"command": "stackTrace", "arguments": {"threadId": 1, "levels": 1}}
{"command": "stepOut", "arguments": {"threadId": 1}}
wait output
{"command": "evaluate", "arguments": {"expression": "TestWindowClick()", "context": "repl"}}
wait terminated
{"command": "disconnect"}
