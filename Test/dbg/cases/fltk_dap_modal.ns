// A breakpoint after a modal alert (needs FLTK): the client taps the button
// and the alert's "OK"; the alert's button script runs in the nested event
// loop while buttonClickScript waits in ModalConfirm; then
// buttonClickScript goes on and stops at line 14. Then the client taps the
// close box, and the program ends.
DefGlobalVar('closeBox, nil);
DefGlobalVar('app, BuildContext({
  _proto: @180, viewBounds: {left: 0, top: 50, right: 200, bottom: 150},
  stepChildren: [
    {_proto: @226, text: "Tap me", viewBounds: {left: 10, top: 10, right: 90, bottom: 30},
     buttonClickScript: func()
       begin
         local answer := ModalConfirm("Sure?", 'okCancel);
         Print(["answer", answer]);
       end}]}));
app:Open();
foreach kid in app:ChildViewFrames() do
  if kid.viewClass = 76 then closeBox := kid;
Print("the app is open");
