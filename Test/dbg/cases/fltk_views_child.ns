// Closing a child view on its own, then its parent (needs FLTK). Each link
// deletes its own widget, children before their parent; a group or window
// only takes the children's widgets out (nfl::Group, nfl::FloatNGo:
// delete_child(), see GroupLink in Host/FLTK/Links.h). A widget deleted
// twice, or used after it was deleted, stops a Debug build (AddressSanitizer).
DefGlobalVar('parent, BuildContext({
  viewClass: 74, viewFlags: 1, viewBounds: {left: 0, top: 0, right: 200, bottom: 120},
  viewQuitScript: func() Print("parent quit"),
  stepChildren: [
    {viewClass: 74, viewFlags: 1, viewBounds: {left: 10, top: 10, right: 190, bottom: 50},
     viewSetupDoneScript: func() theGroup := self,
     viewQuitScript: func() Print("group quit"),
     stepChildren: [
       {viewClass: 81, viewFlags: 1, viewBounds: {left: 10, top: 10, right: 170, bottom: 30},
        text: "in the group", viewQuitScript: func() Print("text quit")}]},
    {viewClass: 81, viewFlags: 1, viewBounds: {left: 10, top: 60, right: 190, bottom: 90},
     text: "second", viewQuitScript: func() Print("second quit")}]}));
DefGlobalVar('theGroup, nil);
parent:Open();
Print([parent.viewCObject <> nil, theGroup.viewCObject <> nil]);
theGroup:Close();
Print([parent.viewCObject <> nil, theGroup.viewCObject]);
parent:Close();
Print([parent.viewCObject, theGroup.viewCObject]);
