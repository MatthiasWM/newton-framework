// 10.7c (needs FLTK): drawing on views (Host/FLTK/Drawing.h). DoDrawing
// and DrawShape draw on a view's canvas, which shows on top of the view
// and its children until the view is drawn anew (Dirty); a
// viewDrawScript draws when the view draws. TestPixel reads the screen
// (gray: 0 black, 255 white), in TestLater, once the window is up. Views
// draw their viewFormat (fill, and the frame outside their bounds); a
// picture view draws its icon in its viewTransferMode (copy by default:
// the icon's 0 bits white). XOR (transferMode 2) inverts what is under the
// shape (macOS: Quartz's difference blend mode); drawn twice, it is gone.
// A text view in XOR mode (viewTransferMode 2) shows white on black, and
// black on white (protoTitle); CoreText ignores the blend mode, so the text
// goes through an image (DrawInverted).
DefGlobalVar('canvasView, nil);
DefGlobalVar('scripted, nil);
DefGlobalVar('framed, nil);
DefGlobalVar('picture, nil);
DefGlobalVar('xorView, nil);
DefGlobalVar('xorText, nil);
DefGlobalVar('xorTitle, nil);
DefGlobalVar('app, BuildContext({
  _proto: @180, viewBounds: {left: 0, top: 30, right: 220, bottom: 225},
  stepChildren: [
    {viewClass: 74, viewFlags: 1, viewBounds: {left: 10, top: 10, right: 210, bottom: 100},
     viewSetupDoneScript: func() canvasView := self},
    {viewClass: 74, viewFlags: 1, viewBounds: {left: 10, top: 110, right: 210, bottom: 160},
     viewSetupDoneScript: func() scripted := self,
     viewDrawScript: func() :DrawShape(MakeRect(0, 0, 200, 50), {penSize: 2})},
    {viewClass: 74, viewFlags: 1, viewFormat: 565, viewBounds: {left: 10, top: 165, right: 50, bottom: 185},
     viewSetupDoneScript: func() framed := self},
    {viewClass: 76, viewFlags: 1, viewFormat: 5, icon: @334, viewBounds: {left: 60, top: 165, right: 73, bottom: 178},
     viewSetupDoneScript: func() picture := self},
    {viewClass: 74, viewFlags: 1, viewBounds: {left: 150, top: 165, right: 190, bottom: 185},
     viewSetupDoneScript: func() xorView := self,
     viewDrawScript: func() begin
       :DrawShape(MakeRect(0, 0, 20, 10), {fillPattern: 5});
       :DrawShape(MakeRect(10, 0, 30, 10), {transferMode: 2, fillPattern: 5});
     end},
    {viewClass: 74, viewFlags: 1, viewFormat: 5, viewBounds: {left: 150, top: 145, right: 210, bottom: 162},
     stepChildren: [{viewClass: 81, viewFlags: 1, text: "WWWW", viewTransferMode: 2,
                     viewFont: {family: 'espy, face: 1, size: 12},
                     viewBounds: {left: 2, top: 2, right: 58, bottom: 15},
                     viewSetupDoneScript: func() xorText := self}]},
    {viewClass: 98, viewFlags: 1, viewFormat: 1, viewTransferMode: 2, text: "WWWW",
     viewFont: {family: 'espy, face: 1, size: 12}, viewJustify: 6,
     viewBounds: {left: 80, top: 165, right: 140, bottom: 185},
     viewSetupDoneScript: func() xorTitle := self}]}));
app:Open();
canvasView:DoDrawing('DrawShape, [MakeRect(0, 0, 40, 30), {fillPattern: 5}]);
canvasView:DrawShape(MakeRect(45, 0, 85, 30), {fillPattern: 3, penSize: 3});
canvasView:DrawShape(MakeOval(90, 0, 130, 30), {fillPattern: 2});
canvasView:DrawShape(MakeRoundRect(135, 0, 195, 30, 12), nil);
canvasView:DrawShape([MakeRect(0, 40, 20, 60), {fillPattern: 5}, MakeRect(30, 40, 50, 60)], {fillPattern: 3});
canvasView:DrawShape(MakeRect(0, 40, 10, 50), {fillPattern: 5, transform: [60, 0]});
TestLater(func() begin
  Print(["black", TestPixel(canvasView, 20, 15), "gray", TestPixel(canvasView, 65, 15),
         "its frame", TestPixel(canvasView, 46, 1), "light gray", TestPixel(canvasView, 110, 15),
         "not filled", TestPixel(canvasView, 165, 15), "its outline", TestPixel(canvasView, 165, 0)]);
  Print(["list: style, then a nested one", TestPixel(canvasView, 10, 50), TestPixel(canvasView, 40, 50),
         "transform", TestPixel(canvasView, 65, 45)]);
  Print(["viewDrawScript", TestPixel(scripted, 0, 0), TestPixel(scripted, 100, 25)]);
  Print(["viewFormat fill", TestPixel(framed, 20, 10), "frame outside", TestPixel(framed, -1, 10),
         "icon: a 0 bit, a 1 bit", TestPixel(picture, 0, 0), TestPixel(picture, 5, 1)]);
  Print(["XOR in a viewDrawScript: black, inverted black, inverted white", TestPixel(xorView, 5, 5),
         TestPixel(xorView, 15, 5), TestPixel(xorView, 25, 5)]);
  local white := 0;
  for x := 0 to 40 do if TestPixel(xorText, x, 6) > 128 then white := white + 1;
  Print(["XOR text on black: white pixels", white > 0]);
  local dark := 0;
  for x := 0 to 59 do if TestPixel(xorTitle, x, 10) < 128 then dark := dark + 1;
  Print(["XOR text on white: dark pixels", dark > 0]);
  xorView:DrawShape(MakeRect(0, 12, 20, 20), {transferMode: 2, fillPattern: 5});
end);
TestLater(func() begin
  Print(["XOR on the canvas once", TestPixel(xorView, 5, 15)]);
  xorView:DrawShape(MakeRect(0, 12, 20, 20), {transferMode: 2, fillPattern: 5});
end);
TestLater(func() begin
  Print(["... twice", TestPixel(xorView, 5, 15)]);
  canvasView:Dirty();   // drawn anew: what was drawn is gone
end);
TestLater(func() Print(["after Dirty", TestPixel(canvasView, 20, 15)]));
foreach kid in app:ChildViewFrames() do
  if kid.viewClass = 76 then TestTap(kid, nil);   // the close box
