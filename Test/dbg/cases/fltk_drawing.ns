// 10.7c (needs FLTK): drawing on views (Host/FLTK/Drawing.h). DoDrawing
// and DrawShape draw on a view's canvas, which shows on top of the view
// and its children until the view is drawn anew (Dirty); a
// viewDrawScript draws when the view draws. TestPixel reads the screen
// (gray: 0 black, 255 white), in TestLater, once the window is up.
DefGlobalVar('canvasView, nil);
DefGlobalVar('scripted, nil);
DefGlobalVar('app, BuildContext({
  _proto: @180, viewBounds: {left: 0, top: 30, right: 220, bottom: 200},
  stepChildren: [
    {viewClass: 74, viewFlags: 1, viewBounds: {left: 10, top: 10, right: 210, bottom: 100},
     viewSetupDoneScript: func() canvasView := self},
    {viewClass: 74, viewFlags: 1, viewBounds: {left: 10, top: 110, right: 210, bottom: 160},
     viewSetupDoneScript: func() scripted := self,
     viewDrawScript: func() :DrawShape(MakeRect(0, 0, 200, 50), {penSize: 2})}]}));
app:Open();
canvasView:DoDrawing('DrawShape, [MakeRect(0, 0, 40, 30), {fillPattern: 5}]);
canvasView:DrawShape(MakeRect(45, 0, 85, 30), {fillPattern: 3, penSize: 3});
canvasView:DrawShape(MakeOval(90, 0, 130, 30), {fillPattern: 2});
canvasView:DrawShape(MakeRoundRect(135, 0, 195, 30, 12), nil);
canvasView:DrawShape([MakeRect(0, 40, 20, 60), {fillPattern: 5}, MakeRect(30, 40, 50, 60)], {fillPattern: 3});
canvasView:DrawShape(MakeRect(0, 40, 10, 50), {fillPattern: 5, transform: [60, 0]});
TestLater(func() begin
  Print(["black", TestPixel(canvasView, 20, 15), "gray", TestPixel(canvasView, 65, 15),
         "its frame", TestPixel(canvasView, 46, 1), "light gray", TestPixel(canvasView, 110, 15),
         "not filled", TestPixel(canvasView, 165, 15), "its outline", TestPixel(canvasView, 165, 0)]);
  Print(["list: style, then a nested one", TestPixel(canvasView, 10, 50), TestPixel(canvasView, 40, 50),
         "transform", TestPixel(canvasView, 65, 45)]);
  Print(["viewDrawScript", TestPixel(scripted, 0, 0), TestPixel(scripted, 100, 25)]);
  canvasView:Dirty();   // drawn anew: what was drawn is gone
end);
TestLater(func() Print(["after Dirty", TestPixel(canvasView, 20, 15)]));
foreach kid in app:ChildViewFrames() do
  if kid.viewClass = 76 then TestTap(kid, nil);   // the close box
