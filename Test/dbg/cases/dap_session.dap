# VS Code's order: initialize; launch; the configuration (breakpoints) after
# the "initialized" event; configurationDone starts the program.
{"command": "initialize", "arguments": {"clientID": "test", "adapterID": "newtonscript", "linesStartAt1": true, "pathFormat": "path"}}
wait initialized
{"command": "launch", "arguments": {"program": "$PROGRAM"}}
{"command": "setBreakpoints", "arguments": {"source": {"path": "$PROGRAM"}, "breakpoints": [{"line": 99}]}}
{"command": "configurationDone"}
wait terminated
{"command": "threads"}
{"command": "noSuchRequest"}
{"command": "disconnect"}
