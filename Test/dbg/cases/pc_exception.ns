// Step 1.3: the PC of a frame that throws inside an instruction.
// breakOnThrows enters the break loop where the exception happens (even
// when a handler catches it). Fail's bytecode: Print is called at pc 8,
// x.slot is a get-path at pc 24, followed by return at pc 25.
// 1. fast loop: Fail's PC is stale, 9 (right after its last call, Print)
// 2. SetDebugMode(true): slow loop, the PC is exact: 25, after the get-path
// 3. breakpoints on, debug mode off: also the slow loop, PC 25; StackTrace
//    still warns, because the ROM warning only looks at SetDebugMode
// Also a regression test for ForgetDeveloperNotified() (second exception
// used to read freed memory).
global Fail(x)
begin
  Print("fail " & x);
  local y := x * 3;
  y := y + 1;
  x.slot;
end;

breakOnThrows := true;
try Fail(1) onexception |evt.ex| do Print("caught 1");
SetDebugMode(true);
try Fail(2) onexception |evt.ex| do Print("caught 2");
SetDebugMode(nil);
NSDEnableBreakPoints(true);
try Fail(3) onexception |evt.ex| do Print("caught 3");
