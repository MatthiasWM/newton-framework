// Line tables (plan 7.1-7.3), compiled with -g: every function gets
// lineTable = [lineTable: file, pc, line, pc, line, ...]. Statements get the
// line of their first token (a multi-line if: its first line); a loop's
// control code at the bottom belongs to the loop's line; a line without
// code (local unused;) has no entry. LineOfPC(fn, pc) finds the line of a
// pc (a prologue before the first entry, like MakeAdder copying n for its
// closure, belongs to the first line); CodeForLine(file, line) where a
// line's code starts, moving to the next statement if the line has none.
global Work(n)
begin
  local sum := 0;
  for i := 1 to n do
    sum := sum + i;
  if sum > 10
    and n > 1 then
    Print("big")
  else
    Print("small");
  while n > 0 do
    n := n - 1;
  sum;
end;

global MakeAdder(n)
begin
  local unused;
  func(x)
    x + n;
end;

// the table without the file name
global Pairs(fn)
begin
  local table := fn.lineTable;
  local pairs := [];
  for i := 1 to Length(table) - 1 do
    AddArraySlot(pairs, table[i]);
  pairs;
end;

printDepth := 0;
Print(Pairs(functions.Work));
Print(Pairs(functions.MakeAdder));
Print(Pairs(MakeAdder(1)));
Print(StrPos(functions.Work.lineTable[0], "/line_tables.ns", 0) > 0);
Print([LineOfPC(functions.Work, 0)[1], LineOfPC(functions.Work, 19)[1],
       LineOfPC(functions.Work, 26)[1], LineOfPC(functions.MakeAdder, 0)[1],
       LineOfPC(GetGlobalFn('Print), 0)]);
printDepth := 1;
foreach line in [11, 12, 15, 17, 19, 22, 23, 26, 28, 99] do
begin
  local found := CodeForLine("line_tables.ns", line);
  Print([line, if found then found.line,
         if found then foreach entry in found.code collect entry[1]]);
end;
