// Print the icon of the package in ref0 (its form part's), for
// cmake/make_app_icon.py (the newtc_app target).
func PrintIcon() begin
  local done := nil;
  foreach part in ref0.part do
    if not done and IsFrame(part.data) and IsFrame(part.data.icon) then begin
      Print(part.data.icon);
      done := true;
    end;
end;
PrintIcon();
