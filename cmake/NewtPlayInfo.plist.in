<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- NewtPlay.app (the NewtPlay target, Matt/NewtPlay.h) -->
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>English</string>
  <key>CFBundleExecutable</key>
  <string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
  <key>CFBundleIdentifier</key>
  <string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>NewtPlay</string>
  <key>CFBundleDisplayName</key>
  <string>NewtPlay</string>
  <key>CFBundleIconFile</key>
  <string>NewtPlay</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
  <key>CFBundleVersion</key>
  <string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
  <key>NSHumanReadableCopyright</key>
  <string>NewtPlay runs Newton packages (newtc, newton-framework)</string>
  <key>LSMinimumSystemVersion</key>
  <string>13.0</string>
  <!-- drawn at the screen's resolution (Retina) -->
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSPrincipalClass</key>
  <string>NSApplication</string>
  <!-- Newton packages: .nspkg and .newtonpkg are NewtPlay's own (it opens
       them on a double click); .pkg is Apple's installer packages: NewtPlay
       only as an alternate (Open With, a drop on it), Installer stays theirs -->
  <key>UTExportedTypeDeclarations</key>
  <array>
    <dict>
      <key>UTTypeIdentifier</key>
      <string>org.newton-framework.newton-package</string>
      <key>UTTypeDescription</key>
      <string>Newton Package</string>
      <key>UTTypeConformsTo</key>
      <array>
        <string>public.data</string>
      </array>
      <key>UTTypeIconFile</key>
      <string>NewtPlay</string>
      <key>UTTypeTagSpecification</key>
      <dict>
        <key>public.filename-extension</key>
        <array>
          <string>nspkg</string>
          <string>newtonpkg</string>
        </array>
      </dict>
    </dict>
  </array>
  <key>CFBundleDocumentTypes</key>
  <array>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Newton Package</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Owner</string>
      <key>CFBundleTypeIconFile</key>
      <string>NewtPlay</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>org.newton-framework.newton-package</string>
      </array>
    </dict>
    <dict>
      <key>CFBundleTypeName</key>
      <string>Package (Newton or Installer)</string>
      <key>CFBundleTypeRole</key>
      <string>Viewer</string>
      <key>LSHandlerRank</key>
      <string>Alternate</string>
      <key>LSItemContentTypes</key>
      <array>
        <string>com.apple.installer-package-archive</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
