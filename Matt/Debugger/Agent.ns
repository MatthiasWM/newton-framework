// Agent.ns: newtc's agent package for the remote debugger, compiled on the
// desktop and installed on the Newton (Remote.ns, NTKRemote:EnsureAgent).
// Embedded in newtc as gAgentScript; running it defines the global
// DAPAgentPackage, the package as a frame (written with NTKMakePackage).
//
// An auto part: the ROM's InstallAutoPart calls partFrame:InstallScript(
// partFrame); what it returns is the remove frame, and RemoveAutoPart calls
// removeFrame:?removeScript(removeFrame). Symbols and frames that stay in
// RAM go through EnsureInternal: the package's own objects are read-only and
// gone once it is removed.
//
// Version 2: the version, and on Einstein a Write that takes any object
// (Einstein's NS Runtime replaces Write with |Einstein:Log|, which only takes
// strings, and NS Debug Tools write characters, numbers, functions; Toolkit
// Protocol.md 7.1) and, while NTK is connected, also sends the text to the
// desktop: NTKSend({|DAPAgent:Write|: text}) (else Print and Write would only
// reach Einstein's log).
// Version 3: only on an Einstein whose NS Runtime doesn't keep the original
// Write (|Einstein:OrigWrite|, fixed by Matt 2026-10-05: its Write then
// forwards to the original, which reaches the desktop by itself).
// Version 4 (plan step 3.7a), needs NS Debug Tools: an NSDBreakLoopEntry
// hook that enters the break loop itself (NSDOriginalBreakLoop) and returns
// nil, so NSDT doesn't print where it stopped (the desktop asks); and
// |DAPAgent:Stack|(exceptionStop): the stopped program's frames, newest
// first, [{name, pc, file, line}, ...] (pc nil for a native function; file
// and line from the function's line table, which newtc's -g puts in it).
// The PC that counts: the stopped frame's (after an exception, the one
// before it, the instruction that threw), the callers' one before theirs
// (their PC is after the call), as DAP.ns does.
// Version 5 (plan step 3.7b): |DAPAgent:Scopes|(level) -> {args, locals,
// receiver (self), temps} and |DAPAgent:Expand|(handle, start, count) -> [[name,
// value], ...]. Values are described, so only what the desktop shows
// travels: a simple value (nil, true, number, character, symbol, string;
// a long string cut) as {value: v}; anything else as {kind: 'frame |
// 'array | 'binary | 'function, cls, count, preview, handle}: preview has
// up to 5 entries {name, value} or {name, kind}, the handle is an index
// into a table here, which |DAPAgent:Stack| empties (a new stop).
// Version 6 (plan step 3.7c): |DAPAgent:Evaluate|(level, fn, names, fresh)
// -> the described result of fn, compiled on the desktop from the
// expression with the frame's variables (names) as parameters; it returns
// [result, the variables afterwards]. Called with the values of the frame
// at level (GetNamedVar) and its receiver as self; changed variables are
// written back (SetNamedVar). level nil: a global expression, no
// arguments. fresh: empty the handle table first (not stopped).
// Version 7 (plan step 3.8): breakpoints in a program from the desktop.
// |DAPAgent:Begin|(program, breakpoints), called by the program first
// (NTKCompileFile), notes the program (its code block, which holds all
// its functions) and installs its breakpoints:
// [[key (the source file), [[path, pc], ...]], ...], path: where the
// function is in the program (PathTo on the desktop); NS Debug Tools'
// InstallBreakPoint, so closures made from it stop too (they share its
// instructions). |DAPAgent:SetBreakpoints|([key, places]) replaces a
// file's breakpoints later (while stopped). A stop at one of them sends
// {|DAPAgent:Stop|: 'breakpoint} before the break loop starts.
// Version 8 (plan step 3.9): stepping. |DAPAgent:Step|(kind, instruction),
// kind 'over, 'into, 'out, called while stopped: by source line where the
// function has a line table (else, or with instruction, one instruction).
// NS Debug Tools step by one instruction (a temporary breakpoint); the stop
// hook checks the rules of newtc's local line step (LineTables.cc,
// StepCheck) and, if it isn't there yet, takes the next NSDT step itself
// (ExitBreakLoop a no-op meanwhile: no break loop is running) and lets the
// program run on to it: no round trip per instruction. The final stop
// sends {|DAPAgent:Stop|: 'step}; a step that can't go on (back into
// native code) sends {|DAPAgent:Step|: message}, and the program
// continues. Another stop on the way (a breakpoint, an exception,
// BreakLoop()) ends the step; its temporary breakpoint is removed.
// Version 9 (plan step 3.10): breakpoints in packages. A place can be
// [path, pc, [package name, part index]]: the path starts at that part's
// data (GetPkgRefInfo(GetPkgRef(name, store)).parts, the same objects the
// installed package uses). |DAPAgent:Reset|() removes all the agent's
// breakpoints (a new session).
// Version 10 (plan step 3.10): decompiled packages. Their line tables
// (from a debug map, .nsdbg) stay on the desktop; |DAPAgent:Known|([[path,
// [package name, part index]], ...]) tells the agent which functions have
// one, and |DAPAgent:Stack| gives a frame of such a function `known` (its
// index there) and `at` (the PC that counts): the desktop finds the line.
// Version 11: no stop at the agent's breakpoints or steps while no desktop
// is connected (a session that ended without cleaning up, e.g. newtc
// killed): they are removed and the program runs on; a stop nobody sees
// would hang the Newton (Matt, Einstein, 2026-10-06).

DefGlobalVar('DAPAgentPackage, {
  signature: 'package0,
  id: "xxxx",
  flags: { noCompression: true },
  version: 11,
  copyright: "newtc",
  name: "DAPAgent:newtc",
  modifyDate: 0,
  info: "newtc's agent for remote debugging",
  part: [
    {
      offset: 0,
      size: 0,
      type: "auto",
      flags: { type: 'nos, Notify: true },
      info: "newtc",
      data: {
        agentVersion: 11,

        InstallScript: func(partFrame)
        begin
          local removeFrame := EnsureInternal({ removeScript: partFrame.RemoveScript });
          DefGlobalFn(EnsureInternal('|DAPAgent:Version|), func() 11);

          // the stop: enter the break loop here, so NSDT prints nothing
          if HasPath(functions, 'NSDBreakLoopEntry) then
            removeFrame.(EnsureInternal('originalHook)) := GetGlobalFn('NSDBreakLoopEntry);
          // breakpoints: the program, and per file {key, installed: [NSDT
          // breakpoints]}
          local program := nil;
          // the instructions of functions whose line table is on the
          // desktop (|DAPAgent:Known|)
          local known := [];
          local placed := [];
          local isOurBreakpoint := func(fn, pc)
          begin
            local instructions := if IsFrame(fn) then fn.instructions;
            if instructions and IsInteger(pc) then
              foreach file in placed do
                foreach bp in file.installed do
                  if bp.instructions = instructions and bp.programCounter = pc then
                    return true;
            nil;
          end;
          // the parts of an installed package (their data), nil if it isn't
          local packageParts := func(name)
          begin
            local stores;
            try
              stores := GetStores();
            onexception |evt.ex| do
              stores := [];
            foreach store in stores do
            begin
              local info := nil;
              try
              begin
                local ref := GetPkgRef(name, store);
                if ref then
                  info := GetPkgRefInfo(ref);
              end
              onexception |evt.ex| do
                info := nil;
              if IsFrame(info) and IsArray(info.parts) then
                return info.parts;
            end;
            nil;
          end;
          // what path leads to from the program (where nil) or from part
          // where[1] of package where[0]; cache: [name, parts] of the last
          // package looked up
          local resolve := func(path, where, cache)
          begin
            local fn := program;
            if IsArray(where) then
            begin
              if not (cache[0] and StrEqual(cache[0], where[0])) then
              begin
                cache[0] := where[0];
                cache[1] := call packageParts with (where[0]);
              end;
              fn := if cache[1] and where[1] < Length(cache[1]) then cache[1][where[1]];
            end;
            foreach step in path do
              fn := if IsFrame(fn) and IsSymbol(step) then fn.(step)
                    else if IsArray(fn) and IsInteger(step) and step < Length(fn) then fn[step];
            fn;
          end;
          local setPlaces := func(entry)
          begin
            local key := entry[0];
            local kept := [];
            foreach file in placed do
              if StrEqual(file.key, key) then
              begin
                foreach bp in file.installed do
                  RemoveBreakPoint(bp);
              end
              else
                AddArraySlot(kept, file);
            placed := kept;
            local file := {key: key, installed: []};
            AddArraySlot(placed, file);
            local cache := [nil, nil];
            foreach place in entry[1] do
            begin
              local fn := call resolve with (place[0], if Length(place) > 2 then place[2], cache);
              if IsFunction(fn) then
                try
                  AddArraySlot(file.installed, InstallBreakPoint(fn, place[1]));
                onexception |evt.ex| do
                  nil;
            end;
            Length(file.installed);
          end;
          DefGlobalFn(EnsureInternal('|DAPAgent:Begin|), func(newProgram, breakpoints)
          begin
            if not (IsFrame(newProgram) and HasPath(functions, 'InstallBreakPoint)) then
              return nil;
            foreach file in placed do
              foreach bp in file.installed do
                RemoveBreakPoint(bp);
            placed := [];
            program := newProgram;
            if IsArray(breakpoints) then
              foreach entry in breakpoints do
                call setPlaces with (entry);
            nil;
          end);
          DefGlobalFn(EnsureInternal('|DAPAgent:SetBreakpoints|), func(entry)
            call setPlaces with (entry));
          DefGlobalFn(EnsureInternal('|DAPAgent:Known|), func(entries)
          begin
            local cache := [nil, nil];
            known := [];
            foreach entry in entries do
            begin
              local fn := call resolve with (entry[0], entry[1], cache);
              AddArraySlot(known, if IsFrame(fn) then fn.instructions);
            end;
            Length(known);
          end);
          DefGlobalFn(EnsureInternal('|DAPAgent:Reset|), func()
          begin
            known := [];
            foreach file in placed do
              foreach bp in file.installed do
                RemoveBreakPoint(bp);
            placed := [];
            program := nil;
            nil;
          end);

          // stepping: {kind, op, instructions, depth (frames below the
          // break loop), line, lastPC, instruction}, nil when not stepping
          local stepping := nil;
          local levelExists := func(level)
          begin
            local found := nil;
            try
            begin
              GetCurrentFunction(level);
              found := true;
            end
            onexception |evt.ex| do
              found := nil;
            found;
          end;
          // [line, at a statement start] for pc of fn, nil without a line table
          local lineAt := func(fn, pc)
          begin
            local table := if IsFrame(fn) and IsInteger(pc) then fn.lineTable;
            if not (IsArray(table) and Length(table) >= 3) then
              return nil;
            local line := table[2];
            local atStart := nil;
            for i := 1 to Length(table) - 2 by 2 do
              if table[i] <= pc then
              begin
                line := table[i + 1];
                atStart := table[i] = pc;
              end;
            [line, atStart];
          end;
          local temporaries := func(remove)
          begin
            local count := 0;
            local all := GetAllBreakPoints();
            if all and all.programCounter then
              for i := Length(all.programCounter) - 1 to 0 by -1 do
                if all.programCounter[i].temporary then
                begin
                  count := count + 1;
                  if remove then
                    ArrayRemoveCount(all.programCounter, i, 1);
                end;
            count;
          end;
          local endStep := func()
          begin
            stepping := nil;
            call temporaries with (true);
          end;
          // one NSDT step; from the hook, ExitBreakLoop does nothing (the
          // hook returns nil instead: no break loop). A string: can't step.
          local runStep := func(op, fromHook)
          begin
            local saved;
            if fromHook then
            begin
              saved := GetGlobalFn('ExitBreakLoop);
              DefGlobalFn('ExitBreakLoop, func() nil);
            end;
            local result;
            try
            begin
              result := if op = 'into then StepIn() else if op = 'out then StepOut() else Step();
              if op = 'into and IsString(result) then      // into native code: over it
                result := Step();
            end
            onexception |evt.ex| do
              result := "Can't step here";
            if fromHook then
              DefGlobalFn('ExitBreakLoop, saved);
            result;
          end;
          // At a step's stop: nil to stop here, else the next step ('over,
          // 'into, 'out). As StepCheck: left the function: the caller (with
          // lines); the same depth: a new statement, or back at a statement
          // start (a loop); deeper (into): a called function's first
          // statement. Code without lines is left with StepOut.
          local stepDecision := func(fn, pc)
          begin
            local s := stepping;
            if s.instruction then
              return nil;
            local depth := if call levelExists with (s.depth) then 1
                           else if call levelExists with (s.depth - 1) then 0 else -1;
            local where := call lineAt with (fn, pc);
            local same := IsFrame(fn) and fn.instructions = s.instructions;
            if depth < 0 then
              return if where then nil else 'out;
            if depth = 0 and not same then
              return if where and where[1] then nil else if where then 'over else 'out;
            if depth = 0 then
            begin
              local stop := s.kind <> 'out and where and where[1] and (where[0] <> s.line or pc <= s.lastPC);
              s.lastPC := pc;
              return if stop then nil else s.op;
            end;
            if s.kind = 'into then
              return if where and where[1] then nil else if where then 'over else 'out;
            'out;
          end;
          DefGlobalFn(EnsureInternal('|DAPAgent:Step|), func(kind, instruction)
          begin
            call endStep with ();
            local fn := GetCurrentFunction(0);
            local pc := GetCurrentPC(0);
            local depth := 0;
            while depth < 200 and call levelExists with (depth) do
              depth := depth + 1;
            local where := call lineAt with (fn, pc);
            stepping := {kind: kind, op: if kind = 'into then 'into else 'over,
                         instructions: if IsFrame(fn) then fn.instructions,
                         depth: depth, line: if where then where[0], lastPC: pc,
                         instruction: instruction or not where};
            local result := call runStep with (if kind = 'out then 'out else stepping.op, nil);
            if IsString(result) then
            begin
              stepping := nil;
              if NTKAlive() then
                NTKSend({|DAPAgent:Step|: result});
              ExitBreakLoop();                // continue, as DAP.ns does
            end;
            nil;
          end);

          DefGlobalFn('NSDBreakLoopEntry, func(fn, pc, params)
          begin
            if not NTKAlive() and (call isOurBreakpoint with (fn, pc)
                                   or (stepping and call temporaries with (nil) = 0)) then
            begin
              // no desktop (a session ended without cleaning up): our
              // breakpoints and step go, the program runs on (a stop
              // nobody sees would hang the Newton)
              call endStep with ();
              foreach file in placed do
                foreach bp in file.installed do
                  RemoveBreakPoint(bp);
              placed := [];
              return nil;
            end;
            if call isOurBreakpoint with (fn, pc) then
            begin
              call endStep with ();
              if NTKAlive() then
                NTKSend({|DAPAgent:Stop|: 'breakpoint});
            end
            else if stepping then
            begin
              if call temporaries with (nil) > 0 then
                call endStep with ()          // something else stopped it
              else
              begin
                local nextStep := call stepDecision with (fn, pc);
                if nextStep then
                begin
                  local result := call runStep with (nextStep, true);
                  if IsString(result) then
                  begin
                    stepping := nil;
                    if NTKAlive() then
                      NTKSend({|DAPAgent:Step|: result});
                  end;
                  return nil;                 // on to the next step's stop
                end;
                stepping := nil;
                if NTKAlive() then
                  NTKSend({|DAPAgent:Stop|: 'step});
              end;
            end;
            NSDOriginalBreakLoop();
            nil;
          end);

          // one frame of the stopped program, nil past the oldest
          local frameInfo := func(level, exceptionStop)
          begin
            local fn := GetCurrentFunction(level);      // throws past the oldest
            local pc := GetCurrentPC(level);
            local isNative := not IsInteger(pc) or pc < 0;
            local info := {name: nil, pc: if isNative then nil else pc};
            foreach symbol, fnValue in functions do
              if fnValue = fn then
                info.name := SymbolName(symbol);
            if not info.name then
            begin
              local implementor;
              try
                implementor := GetCurrentImplementor(level);
              onexception |evt.ex| do
                implementor := nil;
              if IsFrame(implementor) then
                foreach slot, value in implementor do
                  if value = fn then
                    info.name := (if IsString(implementor.debug) then implementor.debug
                                  else if IsSymbol(implementor.appSymbol) then SymbolName(implementor.appSymbol)
                                  else "self") & "." & SymbolName(slot);
            end;
            local table := if not isNative then fn.lineTable;
            local at := if isNative then nil else if level = 0 and not exceptionStop then pc else pc - 1;
            if not isNative and not (IsArray(table) and Length(table) >= 3) and IsFrame(fn) then
              for i := 0 to Length(known) - 1 do
                if known[i] = fn.instructions then
                begin
                  info.known := i;
                  info.at := at;
                end;
            if IsArray(table) and Length(table) >= 3 then
            begin
              local line := table[2];
              for i := 1 to Length(table) - 2 by 2 do
                if table[i] <= at then
                  line := table[i + 1];
              info.file := table[0];
              info.line := line;
            end;
            info;
          end;

          // values described for the desktop (see above)
          local handles := [];
          local isSimple := func(v)
            v = nil or v = true or IsInteger(v) or IsReal(v) or IsCharacter(v)
            or IsSymbol(v) or IsString(v);
          local kindOf := func(v)
            if IsFunction(v) then 'function
            else if IsFrame(v) then 'frame
            else if IsArray(v) then 'array
            else 'binary;
          local describe := func(v)
          begin
            if IsString(v) and StrLen(v) > 500 then
              return {value: SubStr(v, 0, 500), length: StrLen(v)};
            if call isSimple with (v) then
              return {value: v};
            local kind := call kindOf with (v);
            local d := {kind: kind, cls: ClassOf(v), handle: Length(handles)};
            AddArraySlot(handles, v);
            if kind = 'function then
              d.count := GetFunctionArgCount(v)
            else
            begin
              d.count := Length(v);
              if kind = 'frame or kind = 'array then
              begin
                local preview := [];
                if kind = 'frame then
                  foreach slot, value in v do
                  begin
                    if Length(preview) < 5 then
                      AddArraySlot(preview, if call isSimple with (value) and not (IsString(value) and StrLen(value) > 40)
                                            then {name: slot, value: value}
                                            else {name: slot, kind: call kindOf with (value)});
                  end
                else
                  for i := 0 to Min(Length(v), 5) - 1 do
                    AddArraySlot(preview, if call isSimple with (v[i]) and not (IsString(v[i]) and StrLen(v[i]) > 40)
                                          then {name: i, value: v[i]}
                                          else {name: i, kind: call kindOf with (v[i])});
                d.preview := preview;
              end;
            end;
            d;
          end;

          DefGlobalFn(EnsureInternal('|DAPAgent:Scopes|), func(level)
          begin
            local fn := GetCurrentFunction(level);
            local named;
            try
              named := GetAllNamedVars(level);
            onexception |evt.ex| do
              named := nil;
            local argCount := 0;
            try
              argCount := GetFunctionArgCount(fn);
            onexception |evt.ex| do
              argCount := 0;
            local result := {args: [], locals: [], receiver: nil, temps: []};
            local i := 0;
            if IsFrame(named) then
              foreach name, value in named do
              begin
                AddArraySlot(if i < argCount then result.args else result.locals,
                             [name, call describe with (value)]);
                i := i + 1;
              end;
            local receiver;
            try
              receiver := GetCurrentReceiver(level);
            onexception |evt.ex| do
              receiver := nil;
            if IsFrame(receiver) then
              result.receiver := call describe with (receiver);
            local temps;
            try
              temps := GetAllTempVars(level);
            onexception |evt.ex| do
              temps := [];
            for n := 0 to Length(temps) - 1 do
              if not (n = Length(temps) - 1 and temps[n] = 'bottom) then
                AddArraySlot(result.temps, [if n = 0 then "top" else "top-" & n,
                                            call describe with (temps[n])]);
            result;
          end);

          DefGlobalFn(EnsureInternal('|DAPAgent:Expand|), func(handle, start, count)
          begin
            local v := if IsInteger(handle) and handle >= 0 and handle < Length(handles) then handles[handle];
            local items := [];
            local last := start + count - 1;
            if IsFrame(v) and not IsFunction(v) then
            begin
              local i := 0;
              foreach slot, value in v do
              begin
                if i >= start and i <= last then
                  AddArraySlot(items, [slot, call describe with (value)]);
                i := i + 1;
              end;
            end
            else if IsArray(v) then
              for i := start to Min(last, Length(v) - 1) do
                AddArraySlot(items, [i, call describe with (v[i])]);
            items;
          end);

          // the slot that holds the expression's function while the
          // receiver performs it (EnsureInternal: the package's symbol goes
          // with the package)
          local evalSlot := EnsureInternal('|DAPAgent:Eval|);
          DefGlobalFn(EnsureInternal('|DAPAgent:Evaluate|), func(level, fn, names, fresh)
          begin
            if fresh then
              handles := [];
            local values := [];
            local receiver;
            if level then
            begin
              foreach name in names do
                AddArraySlot(values, GetNamedVar(level, name));
              try
                receiver := GetCurrentReceiver(level);
              onexception |evt.ex| do
                receiver := nil;
            end;
            local results;
            if IsFrame(receiver) and not IsReadOnly(receiver) then
            begin
              // self is the receiver itself (assignments to its slots stay)
              receiver.(evalSlot) := fn;
              try
                results := Perform(receiver, evalSlot, values);
              onexception |evt.ex| do
              begin
                RemoveSlot(receiver, evalSlot);
                Rethrow();
              end;
              RemoveSlot(receiver, evalSlot);
            end
            else if IsFrame(receiver) then
            begin
              // read-only (a package's frame): a frame that inherits from it
              local wrapper := {_proto: receiver};
              wrapper.(evalSlot) := fn;
              results := Perform(wrapper, evalSlot, values);
            end
            else
              results := Apply(fn, values);
            if level then
              for i := 0 to Length(names) - 1 do
                if results[i + 1] <> values[i] then
                  SetNamedVar(level, names[i], results[i + 1]);
            call describe with (results[0]);
          end);

          DefGlobalFn(EnsureInternal('|DAPAgent:Stack|), func(exceptionStop)
          begin
            handles := [];              // a new stop: the old handles go
            local frames := [];
            local level := 0;
            local more := true;
            while more and level < 200 do
            begin
              local info;
              try
                info := call frameInfo with (level, exceptionStop);
              onexception |evt.ex| do
                info := nil;
              if info then
                AddArraySlot(frames, info)
              else
                more := nil;
              level := level + 1;
            end;
            frames;
          end);
          if HasPath(functions, '|Einstein:Log|) and not GlobalVarExists('|Einstein:OrigWrite|) then
          begin
            removeFrame.(EnsureInternal('originalWrite)) := functions.Write;
            DefGlobalFn('Write, func(what)
            begin
              local text := if IsString(what) then what else SPrintObject(what);
              |Einstein:Log|(text);
              if NTKAlive() then
                NTKSend({|DAPAgent:Write|: text});
            end);
          end;
          return removeFrame;
        end,

        RemoveScript: func(removeFrame)
        begin
          // the agent's breakpoints go with it (a newer agent replacing it
          // wouldn't know them)
          if HasPath(functions, '|DAPAgent:Reset|) then
            try
              call functions.|DAPAgent:Reset| with ();
            onexception |evt.ex| do
              nil;
          if HasSlot(removeFrame, 'originalWrite) then
            DefGlobalFn('Write, removeFrame.originalWrite);
          if HasSlot(removeFrame, 'originalHook) then
            DefGlobalFn('NSDBreakLoopEntry, removeFrame.originalHook)
          else
            RemoveSlot(functions, 'NSDBreakLoopEntry);
          RemoveSlot(functions, '|DAPAgent:Stack|);
          RemoveSlot(functions, '|DAPAgent:Scopes|);
          RemoveSlot(functions, '|DAPAgent:Expand|);
          RemoveSlot(functions, '|DAPAgent:Evaluate|);
          RemoveSlot(functions, '|DAPAgent:Begin|);
          RemoveSlot(functions, '|DAPAgent:SetBreakpoints|);
          RemoveSlot(functions, '|DAPAgent:Step|);
          RemoveSlot(functions, '|DAPAgent:Reset|);
          RemoveSlot(functions, '|DAPAgent:Known|);
          RemoveSlot(functions, '|DAPAgent:Version|);
        end
      }
    }
  ]
});
