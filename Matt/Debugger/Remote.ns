// Remote.ns: getting packages onto a remote Newton for debugging (plan step
// 3.5b), on top of the NTK... functions (Matt/NTKRemote.h). Embedded in newtc
// as gRemoteScript; NTKLibrary() runs it (and Agent.ns) once and returns the
// global NTKRemote.

DefGlobalVar('NTKRemote, {

  // Apple's NS Debug Tools.pkg, to use instead of newtc's own: NTKLibrary()
  // sets it from the environment variable NEWTC_NSDT_PACKAGE. nil: newtc's
  // own debug tools (DebugToolsPackage.ns, NewtcDebugToolsPackage), unless
  // the Newton has NSDT already.
  debugToolsPackage: nil,

  // The version of newtc's own debug tools this newtc brings
  // (DebugToolsPackage.ns, |DebugTools:newtc:Version|).
  toolsVersion: 1,

  // The agent version this newtc brings (Agent.ns).
  agentVersion: 13,

  // Who shows an upload's progress (DAPRemote: the Debug Console), nil:
  // nobody. Methods UploadStart(name, bytes), UploadTick() (now and then
  // while it goes), UploadEnd().
  reporter: nil,

  // Install a package, replacing one with the same name (a rebuild): 'pkgX'
  // first (no error if it isn't there), then 'pkg '. Returns the Newton's
  // answer: 0, or an error code.
  InstallPackage: func(package)
  begin
    local name := NTKPackageName(package);
    NTKDeletePackage(name);
    if not reporter then
      return NTKInstallPackage(package);
    reporter:UploadStart(name, Length(package));
    NTKInstallPackageAsync(package);
    local result;
    while not (result := NTKPackageResult()) and NTKIsConnected() do
    begin
      reporter:UploadTick();
      NTKPoll(1);
    end;
    reporter:UploadEnd(result);
    if not result then
      Throw('|evt.ex.msg|, "The remote Newton ended the connection");
    result;
  end,

  // Code for the Newton is compiled from strings (Compile): a func() written
  // in a method would be a closure that takes this frame along (NSOF).

  // NS Debug Tools are installed when its BreakLoop replacement is.
  HasDebugTools: func()
    NTKCall(Compile("HasPath(functions, 'NSDOriginalBreakLoop)")),

  // The version of newtc's own debug tools on the Newton, nil if they
  // aren't there.
  OwnToolsVersion: func()
    NTKCall(Compile("if HasPath(functions, '|DebugTools:newtc:Version|) then "
                    & "call functions.|DebugTools:newtc:Version| with ()")),

  // Debug tools on the Newton: newtc's own (installed, or replaced by a
  // newer version) unless Apple's NS Debug Tools are there; Apple's when
  // debugToolsPackage is set. Returns 0, or an error code, or a message.
  EnsureDebugTools: func()
  begin
    if not debugToolsPackage then
    begin
      local version := :OwnToolsVersion();
      if version = toolsVersion then
        return 0;
      if not version and :HasDebugTools() then
        return 0;                       // Apple's NS Debug Tools
      local error := :InstallPackage(NTKMakePackage(NewtcDebugToolsPackage));
      if error <> 0 then
        return error;
      return if :OwnToolsVersion() = toolsVersion then 0 else "newtc's debug tools didn't install";
    end;
    if :HasDebugTools() then
      return 0;
    if not debugToolsPackage then
      return "NS Debug Tools are not installed, and no package for them is set";
    local package;
    try
      package := LoadDataFile(debugToolsPackage, 'package);
    onexception |evt.ex| do
      return "Can't read NS Debug Tools: " & debugToolsPackage;
    local error := :InstallPackage(package);
    if error <> 0 then
      return error;
    return if :HasDebugTools() then 0 else "NS Debug Tools didn't install";
  end,

  // The agent's version on the Newton, nil if it isn't there.
  InstalledAgentVersion: func()
    NTKCall(Compile("if HasPath(functions, '|DAPAgent:Version|) then "
                    & "call functions.|DAPAgent:Version| with ()")),

  // Install (or replace) the agent unless this version is there. Returns 0,
  // or an error code.
  EnsureAgent: func()
  begin
    if :InstalledAgentVersion() = agentVersion then
      return 0;
    return :InstallPackage(NTKMakePackage(DAPAgentPackage));
  end
});
