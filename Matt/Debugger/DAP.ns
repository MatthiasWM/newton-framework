// DAP.ns: the Debug Adapter Protocol for `newtc -dap`, in NewtonScript.
//
// Built into newtc (like NSDebugTools.ns). newtc -dap (newtc.cc,
// handleArgDap) loads the NS Debug Tools, then this file, then:
//   1. DAP:WaitForLaunch() handles requests until the client has sent
//      "launch" and "configurationDone", and returns the launch arguments;
//   2. newtc runs the program (arguments.program) like -script; when it
//      stops in a break loop (breakpoint, step, exception, BreakLoop()),
//      C++ calls DAP:Stopped(reason, text), and the break loop hands every
//      request to DAP:Dispatch() until one resumes the program
//      (ExitBreakLoop);
//   3. DAP:Finish(exitCode) sends "exited" and "terminated" and handles
//      requests until "disconnect" (which quits newtc) or end of input.
//
// Messages are frames. DAPReceive() returns the next one (nil at end of
// input), DAPSend(frame) sends one and adds its "seq". Both convert with
// JSON (Matt/JSON.h): objects <-> frames, false/null -> nil, nil -> false.
// Print and friends become "output" events in C++ (Matt/DAP.cc).
//
// A request {command: "xyz", ...} is handled by DAPRequests.xyz(request),
// which must answer with :SendResponse(request, body). If it throws, the
// client gets an error response with the exception's text.
//
// Keep in mind: NewtonScript compares strings with StrEqual, not "="
// (which compares references). In an array literal, a send needs
// parentheses: [a, (obj:Method())], else "obj:" reads as the array class.
// "and" and "or" have the same precedence (left to right): parenthesize. A symbol keeps the spelling it was first
// created with; this file is loaded before any user code, so the DAP keys
// below get their camelCase spelling. The same goes for names in this file:
// a method called StackFrames would turn the DAP key "stackFrames" into
// "StackFrames". Don't name anything like a DAP key with other capitals.

// A line feed. "\n" in a NewtonScript string is a CR (the Newton line
// ending); output for the client ends lines with LF.
DefineGlobalConstant('kLF, Chr(10));

DefGlobalVar('DAP, {
  launchArgs: nil,    // arguments of the "launch" request
  configured: nil,    // true once "configurationDone" arrived
  running: nil,       // true while the program runs (or is stopped)
  handles: [],        // what each variablesReference (index + 1) stands for
  stopReason: nil,    // why the program stopped (reason as passed to Stopped)
  listings: [],       // the bytecode listings; a sourceReference is index + 1
  lineBreakpoints: [], // breakpoints set in source files, see LineBreakpoint
  nextBreakpointId: 1,
  breakOnExceptions: true,  // the "All Exceptions" filter: breakOnThrows

  // -- Sending

  SendResponse: func(request, body)
  begin
    local response := {type: "response", request_seq: request.seq,
                        success: true, command: request.command};
    if body then response.body := body;
    DAPSend(response);
  end,

  SendErrorResponse: func(request, text)
    DAPSend({type: "response", request_seq: request.seq, success: nil,
             command: request.command, message: text}),

  SendEvent: func(eventName, body)
  begin
    local event := {type: "event", event: eventName};
    if body then event.body := body;
    DAPSend(event);
  end,

  // -- Receiving

  // The text for an error response: the exception's message, or the REPL's
  // text for its error code and the value it is about ("Undefined
  // variable: 'x"; the compiler puts its whole message in the value).
  ExceptionText: func(ex)
  begin
    if ex.message then
      return ex.message;
    local code := if IsFrame(ex.data) then ex.data.errorCode else ex.error;
    local value := if IsFrame(ex.data) then ex.data.value;
    if IsString(value) then
      return value;
    local text := DAPErrorText(code);
    if not text then
      text := "Exception " & ex.name & (if code then ", error " & code else "");
    if value then
      text := text & ": " & :ValueText(value);
    text;
  end,

  // Handle one message from the client. The handlers run with
  // breakOnThrows off (an error in the debugger must not stop in a break
  // loop); afterwards it follows the exception filter while the program
  // runs.
  Dispatch: func(msg)
  begin
    if not (IsFrame(msg) and IsString(msg.type) and StrEqual(msg.type, "request")) then
      return nil;
    local handler := if IsString(msg.command) then GetSlot(DAPRequests, Intern(msg.command));
    if not IsFunction(handler) then
      return :SendErrorResponse(msg, "Unsupported request \"" & msg.command & "\"");
    breakOnThrows := nil;
    try
      Perform(DAPRequests, Intern(msg.command), [msg])
    onexception |evt.ex| do
      :SendErrorResponse(msg, :ExceptionText(CurrentException()));
    breakOnThrows := running and breakOnExceptions;
  end,

  // Handle requests until the program can start. Returns the launch
  // arguments, or nil at end of input.
  WaitForLaunch: func()
  begin
    while not (launchArgs and configured) do
    begin
      local msg := DAPReceive();
      if not msg then return nil;
      :Dispatch(msg);
    end;
    running := true;
    breakOnThrows := breakOnExceptions;
    launchArgs;
  end,

  // The program has ended. Tell the client, then handle requests until
  // "disconnect" (quits newtc) or end of input.
  Finish: func(exitCode)
  begin
    running := nil;
    breakOnThrows := nil;
    :SendEvent("exited", {exitCode: exitCode});
    :SendEvent("terminated", nil);
    local msg;
    while msg := DAPReceive() do
      :Dispatch(msg);
  end,

  // -- Stopping

  // Called by C++ (PDAPOutTranslator) when the program stops in a break
  // loop. reason: "breakpoint", "step", "exception" (text: the exception),
  // "pause" (the client asked), or "breakloop" (the program called
  // BreakLoop(); DAP reason "pause").
  Stopped: func(reason, text)
  begin
    local body := {reason: reason, threadId: 1, allThreadsStopped: true};
    if StrEqual(reason, "breakloop") then
    begin
      body.reason := "pause";
      body.description := "Paused in BreakLoop()";
    end;
    if text then
      body.text := text;
    stopReason := reason;
    handles := [];      // references are valid until the program resumes
    :SendEvent("stopped", body);
  end,

  // The stopped program's stack frames, newest first, as DAP StackFrames.
  // A frame's id is its index in the stack object (0 = oldest) plus 1; ids
  // are valid while the program is stopped. A NewtonScript function's
  // frame points at its source line if it was compiled with a line table
  // (-g; LineOfPC), else into its bytecode listing (see Listing): the
  // newest frame at the instruction that runs next (after an exception: the
  // one that threw), the others at their call (their PC is after it).
  CollectStackFrames: func()
  begin
    local stack := kNSDTools:CurrentStack();
    local frames := [];
    local newest := stack:FindBreakLoop() - 1;
    for frame := newest to 0 by -1 do
    begin
      local fn := stack:Function(frame);
      local name := :FunctionName(fn, stack:Implementor(frame), frame);
      local stackFrame := {id: frame + 1, name: name, line: 0, column: 0};
      if call kNSDIsInterpreted with (fn) then
      begin
        local pc := stack:ProgramCounter(frame);
        local atNext := frame = newest and not (stopReason and StrEqual(stopReason, "exception"));
        local where := LineOfPC(fn, if atNext then pc else pc - 1);
        if where and :IsAbsolutePath(where[0]) then
          stackFrame.source := {name: :FileName(where[0]), path: where[0]}
        else
        begin
          local listing := :Listing(fn, name);
          // path: only for display (VS Code builds the document's URI
          // from it); the text comes from the "source" request
          stackFrame.source := {name: listing.name, path: listing.name, sourceReference: listing.ref};
          where := [nil, :LineOfPC(listing, pc, atNext)];
        end;
        stackFrame.line := where[1];
        stackFrame.column := 1;
      end
      else
        stackFrame.presentationHint := "subtle";
      AddArraySlot(frames, stackFrame);
    end;
    frames;
  end,

  // True for an absolute file path (a line table's file can also be a name
  // like "NSDebugTools.ns" or "<unknown>" for code from Compile()).
  IsAbsolutePath: func(path)
    IsString(path) and StrLen(path) > 1
      and (path[0] = $/ or (StrLen(path) > 2 and path[1] = $: and (path[2] = $\\ or path[2] = $/))),

  // The last part of a path: "/a/b/work.ns" -> "work.ns".
  FileName: func(path)
  begin
    local start := 0;
    for i := 0 to StrLen(path) - 1 do
      if path[i] = $/ or path[i] = $\\ then
        start := i + 1;
    SubStr(path, start, nil);
  end,

  // -- Breakpoints in source files

  // A breakpoint the client set at `line` of the file `path`: {id, path,
  // line (as requested), verified, actualLine, installed (the NS Debug Tools
  // breakpoints)}. It is installed where the code for that line starts
  // (CodeForLine; a line without code moves to the next statement), in
  // every function that has code there. Code that isn't compiled yet
  // leaves it pending; NewCode() tries again after each compiled statement.
  NewLineBreakpoint: func(path, line)
  begin
    local bp := {id: nextBreakpointId, path: path, line: line,
                 verified: nil, actualLine: nil, installed: []};
    nextBreakpointId := nextBreakpointId + 1;
    :InstallLineBreakpoint(bp);
    bp;
  end,

  // Install bp if its code is compiled; true if it was.
  InstallLineBreakpoint: func(bp)
  begin
    local found := if IsInteger(bp.line) then CodeForLine(bp.path, bp.line);
    if not (found and Length(found.code) > 0) then
      return nil;
    foreach place in found.code do
      AddArraySlot(bp.installed, InstallBreakPoint(place[0], place[1]));
    bp.verified := true;
    bp.actualLine := found.line;
    true;
  end,

  RemoveLineBreakpoint: func(bp)
    foreach installed in bp.installed do
      RemoveBreakPoint(installed),

  // bp as a DAP Breakpoint.
  BreakpointBody: func(bp)
  begin
    local body := {id: bp.id, verified: bp.verified,
                   line: if bp.actualLine then bp.actualLine else bp.line};
    if not bp.verified then
      body.message := "No code for this line yet: set when the code is compiled";
    body;
  end,

  // Called by C++ after each top-level statement of the program is compiled
  // and before it runs: install the pending breakpoints that have code now,
  // and tell the client ("breakpoint" event).
  NewCode: func()
  begin
    local saved := breakOnThrows;
    breakOnThrows := nil;
    foreach bp in lineBreakpoints do
      if not bp.verified and :InstallLineBreakpoint(bp) then
        :SendEvent("breakpoint", {reason: "changed", breakpoint: :BreakpointBody(bp)});
    breakOnThrows := saved;
  end,

  // -- Bytecode listings (virtual sources)

  // The listing of a NewtonScript function: its disassembly, one
  // instruction per line ("   25: GetVar  t"), made once per function and
  // kept for the session. {fn, name, ref (the sourceReference), pcs (the PC
  // of each line), text, breakpoints (installed from this listing)}.
  Listing: func(fn, name)
  begin
    foreach listing in listings do
      if listing.fn = fn then
        return listing;
    local disassembler := MakeDisassembler(fn);
    disassembler:PrintVerbosity(nil);
    local pcs := [];
    local text := "";
    local pc := 0;
    local length := Length(fn.instructions);
    while pc < length do
    begin
      AddArraySlot(pcs, pc);
      local instruction := DAPCaptureOutput(func() disassembler:PrintInstruction(pc));
      text := text & (if pc < 10 then "    " else if pc < 100 then "   " else if pc < 1000 then "  " else " ")
              & pc & ": " & instruction & kLF;
      pc := pc + disassembler:InstrLength(pc);
    end;
    local fileName := if StrEqual(name, "<program>") then "program" else name;
    local listing := {fn: fn, name: fileName & ".nsbc", ref: Length(listings) + 1,
                      pcs: pcs, text: text, breakpoints: []};
    AddArraySlot(listings, listing);
    listing;
  end,

  // The line (1-based) of the instruction at pc; if atNext is nil, of the
  // instruction before pc (a caller's PC is after its call instruction).
  LineOfPC: func(listing, pc, atNext)
  begin
    local line := 0;
    foreach index, linePC in listing.pcs do
      if linePC < pc or (atNext and linePC = pc) then
        line := index + 1;
    Max(line, 1);
  end,

  // A short name for the function at a stack frame: Name for a global
  // function, Object.Name for a method, <program> for the program itself.
  FunctionName: func(fn, implementor, frame)
  begin
    local name := kNSDTools:GetDebugNameOf(fn);
    if not name and fn and implementor then
    begin
      local slot := kNSDTools:FindSlotName(implementor, fn);
      if slot then
        name := :ObjectName(implementor) & "." & slot;
    end;
    if not name and fn then
      name := :ShortName(kNSDTools:SearchForObjectName(fn));
    if name then
      return name;
    if frame = 0 then
      return "<program>";
    if not fn then
      return "<unknown function>";
    "<function>";
  end,

  // A name for a frame: its debug name, a global name (without "vars."),
  // or its address.
  ObjectName: func(obj)
  begin
    local name := kNSDTools:GetDebugNameOf(obj);
    if not name then
      name := :ShortName(kNSDTools:SearchForObjectName(obj));
    if name then name else "{" & kNSDTools:RefToHexString(obj) & "}";
  end,

  // -- Variables

  // A new variablesReference for `what`: {items: [[name, value], ...]} (a
  // scope) or {object: frameOrArray}.
  NewHandle: func(what)
  begin
    AddArraySlot(handles, what);
    Length(handles);
  end,

  // The stack object and the index of the frame with DAP id frameId.
  StackAndFrame: func(frameId)
  begin
    local stack := kNSDTools:CurrentStack();
    if not IsInteger(frameId) or frameId < 1 or frameId > stack:FindBreakLoop() then
      Throw('|evt.ex.msg|, "Unknown stack frame " & frameId);
    [stack, frameId - 1];
  end,

  // The arguments and locals of a stack frame, as {args: [[name, value,
  // where], ...], locals: [...]}; where is the index for GetVar/SetVar, or
  // 'find for a variable in the argFrame (FindVar/SetFindVar). Names come
  // from DebuggerInfo (-g, -dbg, -dap; NTK's "Compile for debugging") or,
  // in NOS 1 code, from the argFrame; otherwise they are arg0, ..., loc0, ...
  FrameVariables: func(stack, frame)
  begin
    local fn := stack:Function(frame);
    local args := [];
    local locals := [];
    if not fn then
      return {args: args, locals: locals};
    local numArgs := GetFunctionArgCount(fn);
    if call kNSDHasDebugInfo with (fn) then
    begin
      local info := fn.DebuggerInfo;
      local skip := info[0];
      for i := 0 to Length(info) - skip - 2 do
      begin
        local entry := info[skip + 1 + i];
        // a symbol: the name, the value is on the stack; an integer: the
        // index of the name in info, the variable lives in the argFrame
        // (a closure uses it)
        local pair := if IsSymbol(entry) then [entry, (stack:GetVar(frame, i)), i]
                      else [info[entry], (stack:FindVar(frame, info[entry])), 'find];
        AddArraySlot(if i < numArgs then args else locals, pair);
      end;
    end
    else if ClassOf(fn) = 'CodeBlock then
    begin
      local index := -3;      // skip _nextArgFrame, _parent, _implementor
      foreach name, value in fn.argFrame do
      begin
        if index >= 0 then
          AddArraySlot(if index < numArgs then args else locals,
                       [name, (stack:FindVar(frame, name)), 'find]);
        index := index + 1;
      end;
    end
    else
    begin
      local numVars := if ClassOf(fn) = '_function then numArgs + fn.numArgs div 65536 else numArgs;
      for i := 0 to numVars - 1 do
        if i < numArgs then
          AddArraySlot(args, [Intern("arg" & i), (stack:GetVar(frame, i)), i])
        else
          AddArraySlot(locals, [Intern("loc" & (i - numArgs)), (stack:GetVar(frame, i)), i]);
    end;
    {args: args, locals: locals};
  end,

  // The values the function at `frame` has pushed on the stack and not used
  // yet (half-evaluated expressions), top first.
  FrameTemps: func(stack, frame)
  begin
    local temps := [];
    if call kNSDIsInterpreted with (stack:Function(frame)) then
      for n := 0 to stack:NumTemps(frame) - 1 do
        AddArraySlot(temps, [if n = 0 then "top" else "top-" & n, (stack:temporary(frame, n))]);
    temps;
  end,

  // A DAP Variable for one value; frames and arrays can be expanded.
  // path: a NewtonScript expression for the value (evaluateName, used by
  // "Add to Watch" and "Copy as Expression"), or nil.
  MakeVariable: func(name, value, path)
  begin
    local variable := {name: if IsSymbol(name) then SymbolName(name) else name,
                       value: :ValueText(value), type: :TypeText(value),
                       variablesReference: 0};
    if path then
      variable.evaluateName := path;
    if IsFrame(value) or IsArray(value) then
    begin
      variable.variablesReference := :NewHandle({object: value, path: path});
      if IsArray(value) then
        variable.indexedVariables := Length(value);
    end;
    variable;
  end,

  // True if name (a string) can be written as a variable in NewtonScript.
  IsIdentifier: func(name)
  begin
    if StrLen(name) = 0 then
      return nil;
    for i := 0 to StrLen(name) - 1 do
    begin
      local c := Ord(name[i]);
      // "and" and "or" have the same precedence: parenthesize
      local letter := (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c = 95;
      local digit := c >= 48 and c <= 57;
      if not (letter or (i > 0 and digit)) then
        return nil;
    end;
    true;
  end,

  // A path to a slot or element: base.slot, base[i]; nil if there is no
  // base or the slot name isn't an identifier.
  SubPath: func(base, name)
  begin
    if not base then
      return nil;
    if IsInteger(name) then
      return base & "[" & name & "]";
    if :IsIdentifier(SymbolName(name)) then base & "." & name else nil;
  end,

  // The value of a NewtonScript expression in a stopped stack frame: it
  // sees the frame's arguments and locals by name and self's slots, like
  // code in the function does, and assignments to arguments and locals
  // change them in the frame. How: the expression becomes a function whose
  // parameters are the variables; it returns the result and their values
  // afterwards; DAPCallWithSelf calls it with the frame's receiver as self.
  EvaluateInFrame: func(expression, frameId)
  begin
    local stackAndFrame := :StackAndFrame(frameId);
    local stack := stackAndFrame[0];
    local frame := stackAndFrame[1];
    local frameVars := :FrameVariables(stack, frame);
    local variables := [];
    foreach group in [frameVars.args, frameVars.locals] do
      foreach variable in group do
        if :IsIdentifier(SymbolName(variable[0])) then
          AddArraySlot(variables, variable);
    local params := "";
    local returned := "";
    local values := [];
    foreach variable in variables do
    begin
      local name := SymbolName(variable[0]);
      params := params & (if StrLen(params) > 0 then ", " else "") & name;
      returned := returned & ", " & name;
      AddArraySlot(values, variable[1]);
    end;
    local source := "func(" & params & ") begin local |dap result| := begin "
                    & expression & "\n end; [|dap result|" & returned & "] end";
    local fn := call Compile(source) with ();
    local results := DAPCallWithSelf(fn, stack:Receiver(frame), values);
    for i := 0 to Length(variables) - 1 do
      if results[i + 1] <> values[i] then
        if variables[i][2] = 'find then
          stack:SetFindVar(frame, variables[i][0], results[i + 1])
        else
          stack:SetVar(frame, variables[i][2], results[i + 1]);
    results[0];
  end,

  // After Step(), StepIn(), StepOut(): nil if they resumed the program (it
  // stops again, reason "step"); a message if they can't step there (e.g.
  // returning to C++ at the end of a top-level statement): then continue.
  StepAndRespond: func(request, result)
  begin
    if IsString(result) then
    begin
      :SendEvent("output", {category: "console", output: result & "; continuing." & kLF});
      ExitBreakLoop();
    end;
    :SendResponse(request, nil);
  end,

  // A value as the REPL would print it, on one line and short: nested
  // frames and arrays as {#...}/[#...], at most 10 slots/elements.
  ValueText: func(value)
  begin
    if IsFunction(value) then
      return (if call kNSDIsInterpreted with (value) then "<function, " else "<native function, ")
             & GetFunctionArgCount(value) & (if GetFunctionArgCount(value) = 1 then " arg>" else " args>");
    if IsBinary(value) and not (IsString(value) or IsSymbol(value) or IsReal(value)) then
      return "<" & ClassOf(value) & ", length " & Length(value) & ">";
    local saved := [vars.printDepth, vars.printLength, vars.prettyPrint];
    vars.printDepth := 0;
    vars.printLength := 10;
    vars.prettyPrint := nil;
    local text;
    try
      text := DAPPrintObject(value);
    onexception |evt.ex| do
      text := "<can't print>";
    vars.printDepth := saved[0];
    vars.printLength := saved[1];
    vars.prettyPrint := saved[2];
    text;
  end,

  TypeText: func(value)
    if value = nil then "nil" else SymbolName(ClassOf(value)),

  // "functions.Foo" -> "Foo", "vars.Bar" -> "Bar".
  ShortName: func(name)
  begin
    if not name then
      return nil;
    if BeginsWith(name, "functions.") then
      return SubStr(name, 10, nil);
    if BeginsWith(name, "vars.") then
      return SubStr(name, 5, nil);
    name;
  end,
});

// Request handlers, one per DAP command. self is DAPRequests; slots of DAP
// (launchArgs, SendResponse, ...) are reached through _parent.
DefGlobalVar('DAPRequests, {
  _parent: DAP,

  initialize: func(request)
  begin
    :SendResponse(request, {
      supportsConfigurationDoneRequest: true,
      exceptionBreakpointFilters: [
        {filter: "all", label: "All Exceptions", default: true,
         description: "Stop when an exception is thrown, even if the program catches it (breakOnThrows)"}]});
    :SendEvent("initialized", nil);
  end,

  launch: func(request)
  begin
    local args := request.arguments;
    if not (IsFrame(args) and IsString(args.program)) then
      Throw('|evt.ex.msg|, "launch: \"program\" is missing (the NewtonScript file to run)");
    launchArgs := args;
    :SendResponse(request, nil);
  end,

  // Breakpoints in a bytecode listing (source with a sourceReference) are
  // NS Debug Tools breakpoints at the instruction of each line; they replace
  // the ones set in that listing before. Breakpoints in a source file
  // (source with a path) replace those set in that file before; see
  // NewLineBreakpoint.
  setBreakpoints: func(request)
  begin
    local args := request.arguments;
    local requested := if IsFrame(args) and IsArray(args.breakpoints) then args.breakpoints else [];
    local ref := if IsFrame(args) and IsFrame(args.source) then args.source.sourceReference;
    local breakpoints := [];
    if IsInteger(ref) and ref >= 1 and ref <= Length(listings) then
    begin
      local listing := listings[ref - 1];
      foreach bp in listing.breakpoints do
        RemoveBreakPoint(bp);
      listing.breakpoints := [];
      foreach bp in requested do
        if IsInteger(bp.line) and bp.line >= 1 and bp.line <= Length(listing.pcs) then
        begin
          AddArraySlot(listing.breakpoints, InstallBreakPoint(listing.fn, listing.pcs[bp.line - 1]));
          AddArraySlot(breakpoints, {verified: true, line: bp.line});
        end
        else
          AddArraySlot(breakpoints, {verified: nil, line: bp.line, message: "No instruction on this line"});
    end
    else if IsFrame(args) and IsFrame(args.source) and IsString(args.source.path) then
    begin
      local path := args.source.path;
      local kept := [];
      foreach bp in lineBreakpoints do
        if StrEqual(bp.path, path) then
          :RemoveLineBreakpoint(bp)
        else
          AddArraySlot(kept, bp);
      lineBreakpoints := kept;
      foreach wanted in requested do
      begin
        local bp := :NewLineBreakpoint(path, wanted.line);
        AddArraySlot(lineBreakpoints, bp);
        AddArraySlot(breakpoints, :BreakpointBody(bp));
      end;
    end;
    :SendResponse(request, {breakpoints: breakpoints});
  end,

  // The text of a bytecode listing.
  source: func(request)
  begin
    local args := request.arguments;
    local ref := if IsFrame(args.source) and args.source.sourceReference then
                   args.source.sourceReference else args.sourceReference;
    if not (IsInteger(ref) and ref >= 1 and ref <= Length(listings)) then
      Throw('|evt.ex.msg|, "Unknown source " & ref);
    :SendResponse(request, {content: listings[ref - 1].text,
                            mimeType: "text/x-newtonscript-bytecode"});
  end,

  // The "All Exceptions" checkbox.
  setExceptionBreakpoints: func(request)
  begin
    breakOnExceptions := nil;
    if IsFrame(request.arguments) and IsArray(request.arguments.filters) then
      foreach filter in request.arguments.filters do
        if IsString(filter) and StrEqual(filter, "all") then
          breakOnExceptions := true;
    :SendResponse(request, nil);
  end,

  configurationDone: func(request)
  begin
    configured := true;
    :SendResponse(request, nil);
  end,

  threads: func(request)
    :SendResponse(request, {threads: [{id: 1, name: "NewtonScript"}]}),

  stackTrace: func(request)
  begin
    local frames := :CollectStackFrames();
    local total := Length(frames);
    local args := request.arguments;
    local first := if IsFrame(args) and IsInteger(args.startFrame) then Min(args.startFrame, total) else 0;
    local count := if IsFrame(args) and IsInteger(args.levels) and args.levels > 0 then Min(args.levels, total - first) else total - first;
    local result := Array(count, nil);
    for i := 0 to count - 1 do
      result[i] := frames[first + i];
    :SendResponse(request, {stackFrames: result, totalFrames: total});
  end,

  // Arguments, Locals (with self), and Stack (values the function pushed
  // and hasn't used yet) of one stack frame.
  scopes: func(request)
  begin
    local stackAndFrame := :StackAndFrame(request.arguments.frameId);
    local stack := stackAndFrame[0];
    local frame := stackAndFrame[1];
    local frameVars := :FrameVariables(stack, frame);
    local locals := frameVars.locals;
    local receiver := stack:Receiver(frame);
    if IsFrame(receiver) then
    begin
      local withSelf := [['|self|, receiver]];     // 'self is reserved
      foreach pair in locals do
        AddArraySlot(withSelf, pair);
      locals := withSelf;
    end;
    local scopes := [];
    if Length(frameVars.args) > 0 then
      AddArraySlot(scopes, {name: "Arguments", presentationHint: "arguments",
                            variablesReference: :NewHandle({items: frameVars.args}),
                            expensive: nil});
    if Length(locals) > 0 then
      AddArraySlot(scopes, {name: "Locals", presentationHint: "locals",
                            variablesReference: :NewHandle({items: locals}),
                            expensive: nil});
    local temps := :FrameTemps(stack, frame);
    if Length(temps) > 0 then
      AddArraySlot(scopes, {name: "Stack", variablesReference: :NewHandle({items: temps}),
                            expensive: nil});
    :SendResponse(request, {scopes: scopes});
  end,

  // The variables of a scope, or the slots of a frame, or the elements of
  // an array (with start/count for paging).
  variables: func(request)
  begin
    local ref := request.arguments.variablesReference;
    if not IsInteger(ref) or ref < 1 or ref > Length(handles) then
      Throw('|evt.ex.msg|, "Unknown variablesReference " & ref);
    local what := handles[ref - 1];
    local result := [];
    if what.items then
      foreach pair in what.items do
        AddArraySlot(result, :MakeVariable(pair[0], pair[1],
          if IsSymbol(pair[0]) and :IsIdentifier(SymbolName(pair[0])) then SymbolName(pair[0])
          else if pair[0] = '|self| then "self"))
    else if IsArray(what.object) then
    begin
      local count := Length(what.object);
      local first := if IsInteger(request.arguments.start) then Min(request.arguments.start, count) else 0;
      local last := if IsInteger(request.arguments.count) and request.arguments.count > 0
                    then Min(first + request.arguments.count, count) - 1 else count - 1;
      for i := first to last do
        AddArraySlot(result, :MakeVariable("[" & i & "]", what.object[i], :SubPath(what.path, i)));
    end
    else
      foreach slot, value in what.object do
        AddArraySlot(result, :MakeVariable(slot, value, :SubPath(what.path, slot)));
    :SendResponse(request, {variables: result});
  end,

  // Stepping is Apple's: Step (over calls), StepIn, StepOut, one bytecode
  // instruction at a time. StepIn into a native function or BreakLoop
  // steps over it.
  next: func(request)
    :StepAndRespond(request, Step()),

  stepIn: func(request)
  begin
    local result := StepIn();
    if IsString(result) then
      result := Step();
    :StepAndRespond(request, result);
  end,

  stepOut: func(request)
    :StepAndRespond(request, StepOut()),

  // While the program runs, C++ looks for requests every so often
  // (DAPPoll); DAPPause() makes it stop there, reason "pause".
  pause: func(request)
  begin
    DAPPause();
    :SendResponse(request, nil);
  end,

  // A NewtonScript expression: in a stopped stack frame (frameId) with its
  // variables, else as a global expression. The Debug Console, watches.
  evaluate: func(request)
  begin
    local args := request.arguments;
    if not (IsFrame(args) and IsString(args.expression)) then
      Throw('|evt.ex.msg|, "evaluate: no expression");
    local value := if IsInteger(args.frameId) then
                     :EvaluateInFrame(args.expression, args.frameId)
                   else
                     call Compile(args.expression) with ();
    local variable := :MakeVariable("", value, nil);
    :SendResponse(request, {result: variable.value, type: variable.type,
                            variablesReference: variable.variablesReference});
  end,

  // ExitBreakLoop() only marks the break loop as done (it ends when this
  // request is handled), and throws if the program isn't stopped.
  continue: func(request)
  begin
    ExitBreakLoop();
    :SendResponse(request, {allThreadsContinued: true});
  end,

  disconnect: func(request)
  begin
    :SendResponse(request, nil);
    DAPExit(0);
  end,
});
