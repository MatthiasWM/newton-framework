// DAPRemote.ns: the Debug Adapter Protocol for a program on a remote Newton
// (Einstein, a MessagePad, or newtc -ntk-device), plan step 3.6.
//
// Built into newtc and loaded with DAP.ns. When the "launch" request has a
// "target" (e.g. "tcp" for Einstein: newtc listens on 127.0.0.1:3679, where
// Einstein's serial port connects; "serial:/dev/cu.usbserial-1420@57600";
// see Matt/NTKTransport.h), DAP.ns hands the requests to DAPRemoteRequests,
// and newtc -dap calls DAPRemote:Run(launchArgs) instead of running the
// program itself:
//   1. wait for the Newton (the user taps "Connect" in the newtc app,
//      Connect.ns, or "Connect Inspector" in Toolkit),
//      while still answering requests;
//   2. set breakOnThrows there from the exception filter, install our agent
//      and NS Debug Tools if they are missing (Remote.ns);
//   3. a package (.pkg) is installed there (replacing an older one) and the
//      session goes on until the Newton or the client disconnects; a
//      NewtonScript file (.ns) is compiled here as one top-level block in a
//      try and run there with 'code' (NTKCompileFile);
//   4. what the Newton sends goes to the client: text as output, exceptions
//      as stderr output, a break loop as "stopped"; "continue" sends
//      ExitBreakLoop().
// The stack, variables, breakpoints, and stepping go through newtc's agent
// on the Newton (Agent.ns).

DefGlobalVar('DAPRemote, {
  _parent: DAP,
  depth: 0,             // break loop depth on the Newton ('eext' / 'bext')
  busy: nil,            // a statement or package runs on the Newton
  lastException: nil,   // its text, if it is about to stop in a break loop
  newtonGone: nil,      // the Newton disconnected (not "disconnected": symbols ignore case, and that is a method)
  exceptions: 0,        // exceptions that didn't stop (for the exit code)
  frames: nil,          // the stopped program's stack (agent), until it resumes
  wrapped: nil,         // the program is a .ns file, run in NTKCompileFile's wrapper
  frameNames: nil,      // per stack level: the frame's variable names (for evaluate), this stop
  program: nil,         // the program's code block as compiled here (NTKCompileFile)
  remotePackage: nil,   // or the package: {name, frame (as read here, DAP.package),
                        // wrapped: per part the install slot wrapped (3.15), or nil}
  knownFunctions: [],   // its functions with lines from a debug map (|DAPAgent:Known| order)
  remoteBreakpoints: [],  // {id, path, line, verified, actualLine, places: [[path in program, pc], ...]}
  unsentFiles: [],      // files whose breakpoints changed while the Newton was busy
  stopKind: nil,        // what the agent said about the coming stop ('breakpoint)
  ended: nil,           // EndSession() is done
  startTicks: nil,      // Ticks() when the session's Run started (NEWTC_DAP_TIMES)
  reinstall: nil,       // launch "reinstall": true: upload the package even if unchanged

  Console: func(text)
    :SendEvent("output", {category: "console", output: text & kLF}),

  // Console output that the next one continues (no line end)
  ConsoleText: func(text)
    :SendEvent("output", {category: "console", output: text}),

  // Seconds since ticks (Ticks(): 60 a second), as "2.4 s"
  SecondsSince: func(ticks)
  begin
    local tenths := (Ticks() - ticks) * 10 div 60;
    (tenths div 10) & "." & (tenths mod 10) & " s";
  end,

  // NEWTC_DAP_TIMES=1 (global dapTimes): what was done, when (where the
  // time goes when a session starts)
  Timed: func(what)
    if GlobalVarExists('dapTimes) and dapTimes and startTicks then
      :Console("[" & :SecondsSince(startTicks) & "] " & what),

  // -- What the Newton sends (NTKSetHandler(DAPRemote))

  Connected: func(peer)
    :Console("The Newton is connected."),

  Disconnected: func(reason)
  begin
    newtonGone := true;
    :Console("The Newton disconnected (" & reason & ").");
  end,

  Text: func(text)
    :SendEvent("output", {category: "stdout", output: text}),

  Exception: func(name, data)
  begin
    local text := :RemoteExceptionText(name, data);
    :SendEvent("output", {category: "stderr", output: "    !!! Exception: " & text & kLF});
    if breakOnExceptions then
      lastException := text       // breakOnThrows: a break loop follows
    else
      exceptions := exceptions + 1;
  end,

  BreakLoop: func(entered)
  begin
    if entered then
    begin
      depth := depth + 1;
      frames := nil;
      frameNames := nil;
      :Stopped(if lastException then "exception"
               else if stopKind = 'breakpoint then "breakpoint"
               else if stopKind = 'step then "step"
               else if stopKind = 'entry then "entry"
               else "breakloop", lastException);
      lastException := nil;
      stopKind := nil;
    end
    else if depth > 0 then
      depth := depth - 1;
  end,

  // Text from the agent's Write on Einstein; why the agent stops (before
  // the break loop starts); else e.g. Toolkit's 'dante hello (ignored)
  Object: func(command, object)
    if IsFrame(object) and HasSlot(object, '|DAPAgent:Write|) then
    begin
      local text := Clone(object.|DAPAgent:Write|);
      StrReplace(text, "\n", "" & kLF, nil);     // the Newton's CR ("\n") -> LF
      :SendEvent("output", {category: "stdout", output: text});
    end
    else if IsFrame(object) and HasSlot(object, '|DAPAgent:Stop|) then
      stopKind := object.|DAPAgent:Stop|
    else if IsFrame(object) and HasSlot(object, '|DAPAgent:Step|) then
      :Console(object.|DAPAgent:Step| & "; continuing."),

  Result: func(error, command)
    :Console("The Newton answered '" & command & "' with error " & error & "."),

  // The REPL's text for an exception from the Newton: the error's text and
  // what it is about (the ROM puts it in 'symbol, newtc in 'value).
  RemoteExceptionText: func(name, data)
  begin
    if IsString(data) then
      return data;
    local code := if IsFrame(data) then data.errorCode else data;
    local text := if IsInteger(code) then DAPErrorText(code);
    if not text then
      text := "Exception " & name & (if IsInteger(code) then ", error " & code else "");
    if IsFrame(data) then
    begin
      local about := if HasSlot(data, 'symbol) then data.symbol else data.value;
      if about then
        text := text & ": " & :ValueText(about);
    end;
    text;
  end,

  // Run source code on the Newton and return its result. Inside a try
  // there: an exception in a 'code' block would end the connection (as the
  // ROM does); here it throws evt.ex.msg with its text.
  RemoteCall: func(source)
    :RemoteCallWith(source, nil),

  // RemoteCall with data: the quoted symbol '|dap data| in source stands
  // for it (compiled here: the literal is replaced).
  RemoteCallWith: func(source, data)
  begin
    // breakOnThrows off meanwhile (when the Newton isn't stopped, it is on)
    local block := Compile("begin local |dap result|; local |dap bot| := vars.breakOnThrows; "
      & "breakOnThrows := nil; try |dap result| := begin "
      & source & kLF & " end onexception |evt.ex| do |dap result| := {|DAP error|: CurrentException()}; "
      & "vars.breakOnThrows := |dap bot|; |dap result| end");
    :ReplaceLiteral(block, '|dap data|, data);
    local value := NTKCall(block);
    if IsFrame(value) and HasSlot(value, '|DAP error|) then
      Throw('|evt.ex.msg|, :RemoteExceptionText(value.|DAP error|.name, value.|DAP error|.data));
    value;
  end,

  // -- The session

  // Wait for the Newton or the client, at most seconds; handle a request.
  // The end of the client's input ends newtc.
  Serve: func(seconds)
  begin
    if NTKWaitAny(seconds) = 'dap then
    begin
      local msg := DAPReceive();
      if not msg then
      begin
        :EndSession();
        DAPExit(0);
      end;
      :Dispatch(msg);
    end;
  end,

  Run: func(args)
  begin
    running := nil;           // nothing runs here: no local breakOnThrows
    breakOnThrows := nil;
    startTicks := Ticks();
    reinstall := IsFrame(args) and args.reinstall;
    local library := NTKLibrary();
    library.reporter := DAPRemote;     // the agent's and NSDT's uploads: progress here
    NTKSetHandler(DAPRemote);
    local error := NTKOpen(args.target);
    if error then
    begin
      :Console("Can't use the target \"" & args.target & "\": " & error);
      return :Finish(1);
    end;
    if NTKIsConnected() then
      :Console("The Newton on " & args.target & " is still connected.")
    else
    begin
      :Console("Waiting for a Newton on " & args.target
               & ". On the Newton, tap \"Connect\" in the newtc app (newtc -connect-package"
               & " writes it), or \"Connect Inspector\" in NTK's Toolkit app.");
      while not NTKIsConnected() do
        :Serve(1);
    end;

    :Timed("connected");
    // prepare the Newton: with breakOnThrows off (an error while
    // installing mustn't stop there while we wait for the answer)
    :RemoteCall("breakOnThrows := nil");
    :Timed("breakOnThrows off");
    local result := library:EnsureAgent();
    :Timed("agent checked (installed if needed)");
    if result <> 0 then
      :Console("Warning: newtc's agent package didn't install (" & result & ").")
    else
      :RemoteCall("if HasPath(functions, '|DAPAgent:Reset|) then call functions.|DAPAgent:Reset| with ()");
    :Timed("agent reset");
    result := library:EnsureDebugTools();
    :Timed("NS Debug Tools checked (installed if needed)");
    if result <> 0 then
      :Console("Warning: NS Debug Tools: " & result)
    else
      // breakpoints on: accurate stacks (and no "PC may not be accurate")
      try
        :RemoteCall("GloballyEnableBreakPoints(true)");
      onexception |evt.ex| do
        :Console("Warning: NS Debug Tools: " & :ExceptionText(CurrentException()));

    :Timed("breakpoints enabled");
    if args.attach then
      return :Attach(args.program);

    // run the program
    local program := args.program;
    local length := StrLen(program);
    if length > 4 and StrEqual(SubStr(program, length - 4, 4), ".pkg") then
      return :RunPackage(program);
    local blocks;
    try
      blocks := NTKCompileFile(program);
    onexception |evt.ex| do
    begin
      :Console(:ExceptionText(CurrentException()));
      return :Close(1);
    end;
    :ApplyExceptionFilter();
    wrapped := true;
    :PrepareProgram(blocks[0]);
    foreach block in blocks do
      if newtonGone or not :RunBlock(block) then
        break;
    :Close(if exceptions > 0 then 1 else 0);
  end,

  // A package: install it there (replacing an older one) without waiting
  // (an exception in its install script stops there with "All
  // Exceptions"), set its breakpoints (in the functions of its parts,
  // which -g gave line tables, or a debug map), then serve until the
  // Newton or the client ends the session. The Newton answers requests
  // when idle: evaluate can call the package's functions (and stop in them).
  RunPackage: func(path)
  begin
    local binary := LoadDataFile(path, 'package);
    local name := NTKPackageName(binary);
    remotePackage := {name: name, frame: if IsFrame(package) then package else {}, wrapped: nil};
    :ResolveBreakpoints();
    // breakpoints in an InstallScript, or "Break in InstallScript": the
    // InstallScripts wrapped, the agent told where to stop
    local plan := :InstallPlan();
    if plan then
    begin
      binary := NTKMakePackage(:WrapInstallScripts(plan));
      try
        :RemoteCallWith("if HasPath(functions, '|DAPAgent:InstallPlan|) then "
                        & "call functions.|DAPAgent:InstallPlan| with ('|dap data|)", plan.agent);
      onexception |evt.ex| do
        :Console("Warning: " & :ExceptionText(CurrentException()));
      :Console("Uploading " & name & " with its InstallScript wrapped for debugging.");
    end;
    :Timed("package read, breakpoints resolved");
    // the same bytes as the last upload, still installed: not again (3.17;
    // its InstallScript doesn't run again: "reinstall": true)
    local hash := NTKHash(binary);
    if not plan and not reinstall and StrEqual(:UploadedHash(name), hash) then
    begin
      :Console(:FileName(path) & " is unchanged on the Newton: not uploaded again"
               & " (\"reinstall\": true uploads it, and its InstallScript runs).");
      :ApplyExceptionFilter();
    end
    else
    begin
      NTKDeletePackage(name);         // a rebuild replaces it (no error if it isn't there)
      :Timed("the old " & name & " deleted");
      :ApplyExceptionFilter();
      busy := true;
      :UploadStart(:FileName(path), Length(binary));
      NTKInstallPackageAsync(binary);
      local result;
      while not newtonGone and not (result := NTKPackageResult()) do
      begin
        :UploadTick();
        :Serve(1);
      end;
      :UploadEnd(result);
      busy := nil;
      if newtonGone then
        return :Finish(0);
      :Timed("installed (the InstallScript ran)");
      if result <> 0 then
      begin
        :Console("The Newton couldn't install " & name & " (error " & result & ").");
        return :Close(1);
      end;
      :Console("Installed " & name & " on the Newton.");
      try
        :RemoteCallWith("begin local d := '|dap data|; if HasPath(functions, '|DAPAgent:NoteUpload|) then "
                        & "call functions.|DAPAgent:NoteUpload| with (d[0], d[1]) end", [name, hash]);
      onexception |evt.ex| do
        :Console("Warning: " & :ExceptionText(CurrentException()));
    end;
    :PackageReady(name);
    :Timed("breakpoints set");
    // open its app, as the local debugger does (the ROM's install doesn't):
    // like a program, so its scripts stop at breakpoints and exceptions
    if IsArray(remotePackage.frame.part) then
      foreach part in remotePackage.frame.part do
        if IsString(part.type) and StrEqual(part.type, "form") and IsFrame(part.data)
           and IsSymbol(part.data.app) and not newtonGone then
        begin
          local app := "|" & SymbolName(part.data.app) & "|";
          if :RunBlock(Compile("begin local |dap result|; try |dap result| := begin "
               & "if GetRoot().(EnsureInternal('" & app & ")) then GetRoot().(EnsureInternal('" & app & ")):Open() "
               & "end onexception |evt.ex| do |dap result| := {|DAP error|: CurrentException()}; "
               & "|dap result| end")) then
            :Console("Opened " & SymbolName(part.data.app) & ".");
        end;
    while not newtonGone do
      :Serve(1);
    :Finish(0);
  end,

  // The hash of the package newtc uploaded last as name, if it is still
  // the one installed (the agent knows, version 13); "" if not or unknown
  UploadedHash: func(name)
  begin
    local hash;
    try
      hash := :RemoteCallWith("if HasPath(functions, '|DAPAgent:UploadedHash|) then "
                              & "call functions.|DAPAgent:UploadedHash| with ('|dap data|)", name);
    onexception |evt.ex| do
      hash := nil;
    if IsString(hash) then hash else "";
  end,

  // An upload's progress in the Debug Console, on one line: "Uploading
  // hello2.pkg (18 KB) .......... done in 2.1 s", a dot per tenth the
  // Newton acknowledged (NTKUploadProgress). Also for the agent and NS
  // Debug Tools (Remote.ns: reporter).
  uploadTicks: nil,     // Ticks() when it started, nil when not uploading
  dotsShown: 0,

  UploadStart: func(name, bytes)
  begin
    :ConsoleText("Uploading " & name & " (" & Max(1, (bytes + 512) div 1024) & " KB) ");
    uploadTicks := Ticks();
    dotsShown := 0;
  end,

  // Dots for what arrived so far; " done in 2.1 s" ends the line once all
  // of it is there
  UploadTick: func()
  begin
    if not uploadTicks then
      return nil;
    local progress := NTKUploadProgress();
    local done := not progress or progress[0] >= progress[1];
    local want := if done then 10 else progress[0] * 10 div Max(1, progress[1]);
    if want > dotsShown then
      :ConsoleText(SubStr("..........", 0, want - dotsShown));
    dotsShown := Max(dotsShown, want);
    if done then
    begin
      :Console(" done in " & :SecondsSince(uploadTicks));
      uploadTicks := nil;
    end;
  end,

  // The Newton answered (result) or is gone (nil): end the line
  UploadEnd: func(result)
    if uploadTicks then
    begin
      if result then
        :UploadTick()                     // installed before the dots were all there
      else
      begin
        :Console(" stopped (the Newton disconnected)");
        uploadTicks := nil;
      end;
    end,

  // The package is on the Newton: tell the agent which of its functions
  // have lines from a debug map (it reports them in stacks), and set the
  // breakpoints.
  PackageReady: func(name)
  begin
    local entries := :KnownEntries(name);
    if Length(entries) > 0 then
      try
        :RemoteCallWith("if HasPath(functions, '|DAPAgent:Known|) then call functions.|DAPAgent:Known| with ('|dap data|)", entries);
      onexception |evt.ex| do
        :Console("Warning: " & :ExceptionText(CurrentException()));
    foreach bp in remoteBreakpoints do
      if not LSearch(unsentFiles, bp.path, 0, '|str=|, nil) then
        AddArraySlot(unsentFiles, bp.path);
    :SendBreakpoints();
  end,

  // The functions of the package with lines from a debug map, as
  // [[path in part data, [name, part index]], ...] for |DAPAgent:Known|;
  // knownFunctions gets them in the same order (the agent's index).
  KnownEntries: func(name)
  begin
    local entries := [];
    knownFunctions := [];
    if IsArray(remotePackage.frame.part) then
      foreach i, part in remotePackage.frame.part do
        foreach fn in MappedFunctions(part.data) do
        begin
          AddArraySlot(entries, [:InstalledPath(PathTo(part.data, fn), i), [name, i]]);
          AddArraySlot(knownFunctions, fn);
        end;
    entries;
  end,

  // -- InstallScripts (3.15). An InstallScript runs while the package
  // installs, before breakpoints can be set in the installed package. So
  // the package is uploaded with each part's install function moved to
  // |DAPAgent:InstallScript| and a wrapper in its place, which hands the
  // function that will run (for a form part the ROM's InstallFormPart
  // runs an EnsureInternal copy: the wrapper makes it) to the agent, then
  // calls it with the same self and argument. The agent sets the
  // breakpoints in it (told before the upload), and stops at its start
  // with "Break in InstallScript". Without either, the package goes
  // unchanged.

  // The slot of a part's install function: a form part's devInstallScript
  // (NTK's name for the developer's) or InstallScript, an auto part's
  // InstallScript (as the ROM calls them); nil if it has none.
  InstallSlot: func(part)
  begin
    local data := part.data;
    if not (IsFrame(data) and IsString(part.type)) then
      return nil;
    if StrEqual(part.type, "form") and IsFunction(data.devInstallScript) then
      return 'devInstallScript;
    if (StrEqual(part.type, "form") or StrEqual(part.type, "auto")) and IsFunction(data.InstallScript) then
      return 'InstallScript;
    nil;
  end,

  // A path in part i's data as it is on the Newton: in a wrapped part, the
  // install function moved to |DAPAgent:InstallScript|.
  InstalledPath: func(path, i)
  begin
    local wrapped := if remotePackage then remotePackage.wrapped;
    if not (IsArray(wrapped) and i < Length(wrapped) and wrapped[i]
            and IsArray(path) and Length(path) > 0 and path[0] = wrapped[i]) then
      return path;
    local moved := Clone(path);
    moved[0] := '|DAPAgent:InstallScript|;
    moved;
  end,

  // path without its first step
  RestOf: func(path)
  begin
    local rest := Array(Length(path) - 1, nil);
    for j := 1 to Length(path) - 1 do
      rest[j - 1] := path[j];
    rest;
  end,

  // What to wrap and what the agent needs, nil if nothing: {parts:
  // [{index, slot, form}], agent: {name, parts: [{index, places: [[path
  // in the function, pc], ...], known: [[path in the function, index in
  // knownFunctions], ...]}], entry, knownCount}}. From now on the
  // breakpoints' paths lead to the moved functions (remotePackage.wrapped).
  InstallPlan: func()
  begin
    local frame := remotePackage.frame;
    if not IsArray(frame.part) then
      return nil;
    local slots := Array(Length(frame.part), nil);
    foreach i, part in frame.part do
      slots[i] := :InstallSlot(part);
    local knownEntries := :KnownEntries(remotePackage.name);
    local parts := [];
    local agentParts := [];
    local anyPlace := nil;
    foreach i, slot in slots do
      if slot then
      begin
        local places := [];
        foreach bp in remoteBreakpoints do
          foreach place in bp.places do
            if Length(place) > 2 and place[2][1] = i and Length(place[0]) > 0 and place[0][0] = slot then
              AddArraySlot(places, [:RestOf(place[0]), place[1]]);
        local known := [];
        foreach k, entry in knownEntries do
          if entry[1][1] = i and Length(entry[0]) > 0 and entry[0][0] = slot then
            AddArraySlot(known, [:RestOf(entry[0]), k]);
        if Length(places) > 0 or breakOnInstall then
        begin
          anyPlace := anyPlace or Length(places) > 0;
          AddArraySlot(parts, {index: i, slot: slot,
                               form: StrEqual(frame.part[i].type, "form")});
          AddArraySlot(agentParts, {index: i, places: places, known: known});
        end;
      end;
    if Length(parts) = 0 then
      return nil;
    // the places now lead to the moved functions
    local wrapped := Array(Length(slots), nil);
    foreach p in parts do
      wrapped[p.index] := p.slot;
    remotePackage.wrapped := wrapped;
    foreach bp in remoteBreakpoints do
      foreach place in bp.places do
        if Length(place) > 2 then
          place[0] := :InstalledPath(place[0], place[2][1]);
    {parts: parts,
     agent: {name: remotePackage.name, parts: agentParts, entry: breakOnInstall,
             knownCount: Length(knownFunctions)}};
  end,

  // The package with the parts of plan wrapped (copies: the package as
  // read stays as it is)
  WrapInstallScripts: func(plan)
  begin
    local frame := remotePackage.frame;
    local wrappedPackage := Clone(frame);
    wrappedPackage.part := Clone(frame.part);
    foreach p in plan.parts do
    begin
      local part := Clone(frame.part[p.index]);
      local data := Clone(part.data);
      data.|DAPAgent:InstallScript| := data.(p.slot);
      data.(p.slot) := :InstallWrapper(p.index, p.form);
      part.data := data;
      wrappedPackage.part[p.index] := part;
    end;
    wrappedPackage;
  end,

  // The wrapper for part i's install function (compiled from a string: a
  // func() here would take this frame along). self is the part frame (an
  // auto part) or the ROM's context {_proto: partFrame, ...} (a form part:
  // RAM, so the copy can go there).
  InstallWrapper: func(i, form)
    call Compile("func(arg) begin local fn := self.|DAPAgent:InstallScript|; "
      & (if form then "fn := EnsureInternal(fn); self.|DAPAgent:InstallScript| := fn; " else "")
      & "if HasPath(functions, '|DAPAgent:Installing|) then "
      & "try call functions.|DAPAgent:Installing| with (fn, " & i & ") onexception |evt.ex| do nil; "
      & "self:|DAPAgent:InstallScript|(arg) end") with (),

  // "attach": nothing is installed or run; the Newton goes on as it is,
  // and breakpoints, exceptions ("All Exceptions"), and BreakLoop() stop
  // it. path: the package (.pkg) that is installed there (for its line
  // tables or debug map), or nil. Serve until the Newton or the client
  // ends the session ("disconnect": breakpoints removed, it runs on).
  Attach: func(path)
  begin
    if IsString(path) then
    begin
      local binary := LoadDataFile(path, 'package);
      local name := NTKPackageName(binary);
      remotePackage := {name: name, frame: if IsFrame(package) then package else {}};
      :ResolveBreakpoints();
      // the size the Newton reports for it (GetPkgRefInfo), nil if it isn't there
      local size;
      try
        size := :RemoteCallWith("begin local info; foreach store in GetStores() do "
          & "if not info then begin local ref := GetPkgRef('|dap data|, store); "
          & "if ref then info := GetPkgRefInfo(ref) end; if info then info.size end", name);
      onexception |evt.ex| do
        size := nil;
      if not size then
        :Console("Warning: " & name & " isn't installed on the Newton: its breakpoints won't be set.")
      else
      begin
        if size <> Length(binary) then
          :Console("Warning: the " & name & " on the Newton (" & size & " bytes) isn't "
                   & :FileName(path) & " (" & Length(binary) & " bytes): another build? "
                   & "Breakpoints may not match.");
        :PackageReady(name);
      end;
    end;
    :ApplyExceptionFilter();
    :Console("Attached" & (if remotePackage then " to " & remotePackage.name else "")
             & ". The Newton runs on: breakpoints, exceptions, and BreakLoop() stop it.");
    while not newtonGone do
      :Serve(1);
    :Finish(0);
  end,

  // Run the program on the Newton ('code': the whole file in a try, see
  // NTKCompileFile) and wait until it is done, serving requests meanwhile
  // (a break loop on the way: "stopped", then requests until "continue").
  // Returns nil if an exception ended it (like -script).
  RunBlock: func(block)
  begin
    busy := true;
    local pending := NTKCallAsync(block);
    local answer;
    while not (answer := NTKCallResult(pending)) and not newtonGone do
      :Serve(1);
    busy := nil;
    if not answer then
      return nil;
    local result := answer.value;
    if IsFrame(result) and HasSlot(result, '|DAP error|) then
    begin
      // with breakOnThrows the Newton reported it and stopped; else it is
      // reported here
      if not breakOnExceptions then
      begin
        local ex := result.|DAP error|;
        :SendEvent("output", {category: "stderr",
          output: "    !!! Exception: " & :RemoteExceptionText(ex.name, ex.data) & kLF});
        exceptions := exceptions + 1;
      end;
      return nil;
    end;
    true;
  end,

  // breakOnThrows on the Newton as the "All Exceptions" filter says.
  ApplyExceptionFilter: func()
    :RemoteCall("breakOnThrows := " & (if breakOnExceptions then "true" else "nil")),

  // The stopped program's frames as DAP StackFrames, newest first; id =
  // level + 1. From the agent (NS Debug Tools), asked once per stop.
  RemoteStackFrames: func()
  begin
    if not frames then
    begin
      local exceptionStop := stopReason and StrEqual(stopReason, "exception");
      local remote;
      try
        remote := :RemoteCall("if HasPath(functions, '|DAPAgent:Stack|) and "
          & "HasPath(functions, 'GetCurrentFunction) then call functions.|DAPAgent:Stack| with ("
          & (if exceptionStop then "true" else "nil") & ")");
      onexception |evt.ex| do
        remote := nil;
      frames := [];
      if IsArray(remote) then
        foreach level, info in remote do
        begin
          local where;
          local name := info.name;
          if not name then
            name := if level = Length(remote) - 1 then "<program>" else "<function>";
          local frame := {id: level + 1, name: name, line: 0, column: 0};
          if not info.pc then
            frame.presentationHint := "subtle"
          else if IsString(info.file) and :IsAbsolutePath(info.file) then
          begin
            frame.source := {name: :FileName(info.file), path: info.file};
            frame.line := info.line;
            frame.column := 1;
          end
          else if IsInteger(info.known) and info.known < Length(knownFunctions)
                  and (where := LineOfPC(knownFunctions[info.known], info.at))
                  and :IsAbsolutePath(where[0]) then
          begin
            // a decompiled package: the line table is here (debug map)
            frame.source := {name: :FileName(where[0]), path: where[0]};
            frame.line := where[1];
            frame.column := 1;
          end
          else
            frame.name := name & ", pc " & info.pc;
          AddArraySlot(frames, frame);
        end;
    end;
    frames;
  end,

  // Replace the literal `symbol` (a quoted symbol in the source) of a code
  // block compiled here with `value`.
  ReplaceLiteral: func(block, symbol, value)
  begin
    local literals := block.literals;
    if IsArray(literals) then
      for i := 0 to Length(literals) - 1 do
        if IsSymbol(literals[i]) and literals[i] = symbol then
          literals[i] := value;
  end,

  // -- Breakpoints (agent v7): set in the program's functions on the Newton

  // Where bp's line is in the program: [path to the function in the
  // program block, pc] for each function with code there (CodeForLine; a
  // line without code moves to the next statement).
  ResolveRemoteBreakpoint: func(bp)
  begin
    bp.verified := nil;
    bp.places := [];
    local found := if (program or remotePackage) and IsInteger(bp.line) then CodeForLine(bp.path, bp.line);
    if found then
      foreach place in found.code do
      begin
        local where := if program then PathTo(program, place[0]);
        if where then
          AddArraySlot(bp.places, [where, place[1]])
        else if remotePackage and IsArray(remotePackage.frame.part) then
          foreach i, part in remotePackage.frame.part do
            if not where and (where := PathTo(part.data, place[0])) then
              AddArraySlot(bp.places, [:InstalledPath(where, i), place[1], [remotePackage.name, i]]);
      end;
    if Length(bp.places) > 0 then
    begin
      bp.verified := true;
      bp.actualLine := found.line;
    end;
  end,

  RemoteBreakpointBody: func(bp)
  begin
    local body := {id: bp.id, verified: bp.verified,
                   line: if bp.verified then bp.actualLine else bp.line};
    if not bp.verified then
      body.message := if program then "No code for this line in the program"
                      else if remotePackage then "No code for this line in the package"
                      else "Set when the program is compiled";
    body;
  end,

  // [file, places] for the agent: all breakpoints of the file
  BreakpointEntry: func(path)
  begin
    local places := [];
    foreach bp in remoteBreakpoints do
      if StrEqual(bp.path, path) then
        foreach place in bp.places do
          AddArraySlot(places, place);
    [path, places];
  end,

  // The client set the breakpoints of a file: resolve them, tell the
  // agent (if the Newton listens now: stopped or idle; else before it
  // continues). Returns their DAP Breakpoints.
  SetRemoteBreakpoints: func(path, requested)
  begin
    local all := [];
    foreach bp in remoteBreakpoints do
      if not StrEqual(bp.path, path) then
        AddArraySlot(all, bp);
    local bodies := [];
    foreach wanted in requested do
    begin
      local bp := {id: nextBreakpointId, path: path, line: wanted.line,
                   verified: nil, actualLine: nil, places: []};
      nextBreakpointId := nextBreakpointId + 1;
      :ResolveRemoteBreakpoint(bp);
      AddArraySlot(all, bp);
      AddArraySlot(bodies, :RemoteBreakpointBody(bp));
    end;
    remoteBreakpoints := all;
    if program or remotePackage then
    begin
      if not LSearch(unsentFiles, path, 0, '|str=|, nil) then
        AddArraySlot(unsentFiles, path);
      :SendBreakpoints();
    end;
    bodies;
  end,

  // Tell the agent about the files whose breakpoints changed, if the
  // Newton listens (stopped, or idle).
  SendBreakpoints: func()
  begin
    if not (NTKIsConnected() and (depth > 0 or not busy)) then
      return;
    foreach path in unsentFiles do
      try
        :RemoteCallWith("call functions.|DAPAgent:SetBreakpoints| with ('|dap data|)",
                        :BreakpointEntry(path));
      onexception |evt.ex| do
        :Console("Warning: breakpoints in " & path & ": " & :ExceptionText(CurrentException()));
    unsentFiles := [];
  end,

  // The program is compiled: resolve the breakpoints (the client hears of
  // the ones that change) and give the block its two literals for the
  // agent's Begin: itself and the breakpoints.
  PrepareProgram: func(block)
  begin
    program := block;
    local entries := :ResolveBreakpoints();
    :ReplaceLiteral(block, '|DAPAgent:program|, block);
    :ReplaceLiteral(block, '|DAPAgent:breakpoints|, entries);
  end,

  // Resolve the breakpoints (now that the program or package is here); the
  // client hears of the ones that change. Returns [[file, places], ...].
  ResolveBreakpoints: func()
  begin
    local files := [];
    foreach bp in remoteBreakpoints do
    begin
      local was := bp.verified;
      :ResolveRemoteBreakpoint(bp);
      if bp.verified or was then
        :SendEvent("breakpoint", {reason: "changed", breakpoint: :RemoteBreakpointBody(bp)});
      if not LSearch(files, bp.path, 0, '|str=|, nil) then
        AddArraySlot(files, bp.path);
    end;
    local entries := [];
    foreach path in files do
      AddArraySlot(entries, :BreakpointEntry(path));
    unsentFiles := [];
    entries;
  end,

  // The scopes of the frame at level from the agent ({args, locals,
  // receiver, temps}), nil without it. The program's frame without
  // NTKCompileFile's wrapper (its local and its try's two stack values,
  // the oldest). Notes the frame's variable names for evaluate.
  RemoteScopes: func(level)
  begin
    if not (IsInteger(level) and level >= 0 and level < Length(:RemoteStackFrames())) then
      return nil;
    local remote;
    try
      remote := :RemoteCall("if HasPath(functions, '|DAPAgent:Scopes|) then "
        & "call functions.|DAPAgent:Scopes| with (" & level & ")");
    onexception |evt.ex| do
      remote := nil;
    if not IsFrame(remote) then
      return nil;
    if wrapped and level = Length(frames) - 1 then
    begin
      local mine := [];
      foreach pair in remote.locals do
        if pair[0] <> '|dap result| then
          AddArraySlot(mine, pair);
      remote.locals := mine;
      remote.temps := if Length(remote.temps) > 2 then ArrayMunger(remote.temps, Length(remote.temps) - 2, 2, nil, 0, 0) else [];
    end;
    local names := [];
    foreach group in [remote.args, remote.locals] do
      foreach pair in group do
        if IsSymbol(pair[0]) and :IsIdentifier(SymbolName(pair[0])) then
          AddArraySlot(names, pair[0]);
    if not frameNames then
      frameNames := Array(Length(frames), nil);
    frameNames[level] := names;
    remote;
  end,

  // Evaluate an expression on the Newton (agent v6, |DAPAgent:Evaluate|):
  // in the frame at level (its arguments and locals by name, self's slots;
  // assignments to its variables stay), or globally (level nil). With
  // breakOnThrows off meanwhile: an error throws evt.ex.msg here, it
  // doesn't stop. Returns the described result.
  RemoteEvaluate: func(expression, level)
  begin
    local names := [];
    if level then
    begin
      if not (frameNames and frameNames[level]) then
        :RemoteScopes(level);
      if frameNames and frameNames[level] then
        names := frameNames[level];
    end;
    local params := "";
    local returned := "";
    local symbols := "";
    foreach name in names do
    begin
      params := params & (if StrLen(params) > 0 then ", " else "") & name;
      returned := returned & ", " & name;
      symbols := symbols & (if StrLen(symbols) > 0 then ", " else "") & name;
    end;
    // compiled here: a syntax error throws before anything is sent
    local source := "func(" & params & ") begin local |dap result| := begin "
                    & expression & kLF & " end; [|dap result|" & returned & "] end";
    Compile(source);
    local block := Compile("begin local |dap result|; local |dap bot| := vars.breakOnThrows; "
      & "breakOnThrows := nil; try |dap result| := if HasPath(functions, '|DAPAgent:Evaluate|) then "
      & "call functions.|DAPAgent:Evaluate| with (" & (if level then level else "nil") & ", "
      & source & ", '[" & symbols & "], " & (if depth = 0 then "true" else "nil") & ") "
      & "else {|DAP error|: {name: '|evt.ex.msg|, data: \"newtc's agent isn't on the Newton\"}}"
      & " onexception |evt.ex| do |dap result| := {|DAP error|: CurrentException()}; "
      & "vars.breakOnThrows := |dap bot|; |dap result| end");
    // what it calls may stop at a breakpoint: serve requests until the
    // answer comes (the response then waits until the user continues)
    local pending := NTKCallAsync(block);
    local wasBusy := busy;
    busy := true;
    local answer;
    while not (answer := NTKCallResult(pending)) and not newtonGone do
      :Serve(1);
    busy := wasBusy;
    if not answer then
      Throw('|evt.ex.msg|, "The Newton disconnected");
    local value := answer.value;
    if IsFrame(value) and HasSlot(value, '|DAP error|) then
      Throw('|evt.ex.msg|, :RemoteExceptionText(value.|DAP error|.name, value.|DAP error|.data));
    value;
  end,

  // A DAP Variable for a value the agent described (Agent.ns, version 5):
  // {value: v} is the value itself, else {kind, cls, count, preview,
  // handle} stands for a frame, array, binary, or function on the Newton;
  // frames and arrays expand with |DAPAgent:Expand|.
  MakeRemoteVariable: func(name, described, path)
  begin
    if not HasSlot(described, 'kind) then
    begin
      local variable := :MakeVariable(name, described.value, path);
      if described.length then        // a long string, cut
        variable.value := variable.value & "... (length " & described.length & ")";
      return variable;
    end;
    local variable := {name: if IsSymbol(name) then SymbolName(name) else name,
                       value: :RemotePreview(described),
                       type: if described.cls then SymbolName(described.cls) else SymbolName(described.kind),
                       variablesReference: 0};
    if path then
      variable.evaluateName := path;
    if described.kind = 'frame or described.kind = 'array then
    begin
      variable.variablesReference := :NewHandle({remote: described.handle, kind: described.kind,
                                                 count: described.count, path: path});
      if described.kind = 'array then
        variable.indexedVariables := described.count;
    end;
    variable;
  end,

  // The one-line text for a described value: {a: 1, list: [...], ...},
  // [1, 2, {...}], <function, 2 args>, <bits, length 12>.
  RemotePreview: func(described)
  begin
    local kind := described.kind;
    if kind = 'function then
      return "<function, " & described.count & (if described.count = 1 then " arg>" else " args>");
    if kind = 'binary then
      return "<" & described.cls & ", length " & described.count & ">";
    local text := "";
    foreach item in described.preview do
    begin
      if StrLen(text) > 0 then
        text := text & ", ";
      if kind = 'frame then
        text := text & SymbolName(item.name) & ": ";
      text := text & (if HasSlot(item, 'value) then :ValueText(item.value)
                      else if item.kind = 'frame then "{...}"
                      else if item.kind = 'array then "[...]"
                      else if item.kind = 'function then "<function>"
                      else "<binary>");
    end;
    if described.count > Length(described.preview) then
      text := text & (if StrLen(text) > 0 then ", ..." else "...");
    if kind = 'frame then "{" & text & "}" else "[" & text & "]";
  end,

  // Step on the Newton (agent v8, |DAPAgent:Step|): kind 'over, 'into,
  // 'out; by source line, or one instruction (granularity "instruction").
  // Like continue: the stop comes as a break loop ("step").
  RemoteStep: func(request, kind)
  begin
    if depth = 0 then
      Throw('|evt.ex.msg|, "The program on the Newton isn't stopped");
    if Length(:RemoteStackFrames()) = 0 then
      Throw('|evt.ex.msg|, "Stepping needs NS Debug Tools and newtc's agent on the Newton");
    local args := request.arguments;
    local instruction := IsFrame(args) and IsString(args.granularity)
                         and StrEqual(args.granularity, "instruction");
    :SendBreakpoints();
    NTKLeaveBreakLoop(Compile("begin try call functions.|DAPAgent:Step| with ('" & kind & ", "
      & (if instruction then "true" else "nil") & ") onexception |evt.ex| do nil; nil end"));
    frames := nil;
    frameNames := nil;
    :SendResponse(request, nil);
  end,

  // The program has ended: end the connection, then the session.
  Close: func(exitCode)
  begin
    :EndSession();
    :Finish(exitCode);
  end,

  // The session ends: the agent's breakpoints go and a stopped program
  // goes on (a stop nobody sees would hang the Newton), then the
  // connection. Nothing waits for answers: the Newton handles these calls
  // in order, before the connection's end. newtc -dap-server keeps the
  // connection for the next session: breakOnThrows goes off there, and
  // DAPServerIdle handles what the Newton does meanwhile.
  EndSession: func()
  begin
    if ended then
      return nil;
    ended := true;
    local keep := GlobalVarExists('dapServer) and dapServer;
    if NTKIsConnected() then
    begin
      NTKCallAsync(Compile("begin local |dap bot| := vars.breakOnThrows; breakOnThrows := nil; "
        & "try if HasPath(functions, '|DAPAgent:Reset|) then call functions.|DAPAgent:Reset| with () "
        & "onexception |evt.ex| do nil; vars.breakOnThrows := "
        & (if keep then "nil" else "|dap bot|") & "; nil end"));
      for i := 1 to depth do
        NTKLeaveBreakLoop(:ExitBreakLoopBlock());
    end;
    if keep then
      NTKSetHandler(DAPServerIdle)
    else
      NTKClose();
  end,

  // ExitBreakLoop() for the Newton, harmless if it isn't in a break loop
  // after all (our depth lags behind until its 'bext' arrives: e.g. a
  // disconnect right after continue): there it would throw, and with
  // breakOnThrows stop in a new break loop.
  ExitBreakLoopBlock: func()
    Compile("begin local |dap bot| := vars.breakOnThrows; breakOnThrows := nil; "
      & "try ExitBreakLoop() onexception |evt.ex| do nil; vars.breakOnThrows := |dap bot|; nil end"),
});


// newtc -dap-server between sessions: the Newton stays connected, nobody
// debugs. A break loop (BreakLoop(), a breakpoint the agent didn't set)
// is left at once: a stop nobody sees would hang the Newton. What isn't
// handled here, newtc prints in its terminal (text, exceptions, the
// connection's end and a new one).
DefGlobalVar('DAPServerIdle, {
  BreakLoop: func(entered)
    if entered then
    begin
      Write("ntk: a break loop on the Newton, no debug session: it goes on" & kLF);
      NTKLeaveBreakLoop(DAPRemote:ExitBreakLoopBlock());
    end,
});


// The requests that work differently with a remote Newton; the others are
// DAP.ns's (DAPRequests).
DefGlobalVar('DAPRemoteRequests, {
  _parent: DAPRequests,

  continue: func(request)
  begin
    if DAPRemote.depth = 0 then
      Throw('|evt.ex.msg|, "The program on the Newton isn't stopped");
    // with 'code' (with 'lscb' the REP would echo "#2 NIL"); its answer
    // comes when the break loop ends, nobody waits for it
    DAPRemote:SendBreakpoints();       // changed while it ran
    NTKLeaveBreakLoop(DAPRemote:ExitBreakLoopBlock());
    DAPRemote.frames := nil;
    DAPRemote.frameNames := nil;
    :SendResponse(request, {allThreadsContinued: true});
  end,

  pause: func(request)
    Throw('|evt.ex.msg|, "Pause doesn't work on a remote Newton yet"),

  next: func(request)
    DAPRemote:RemoteStep(request, 'over),

  stepIn: func(request)
    DAPRemote:RemoteStep(request, 'into),

  stepOut: func(request)
    DAPRemote:RemoteStep(request, 'out),

  // The Newton's stack (from the agent; without NS Debug Tools one frame
  // that says where the program is), with startFrame/levels paging.
  stackTrace: func(request)
  begin
    local all := DAPRemote:RemoteStackFrames();
    if Length(all) = 0 then
      all := [{id: 1, name: "on the Newton", line: 0, column: 0}];
    local total := Length(all);
    local args := request.arguments;
    local first := if IsFrame(args) and IsInteger(args.startFrame) then Min(args.startFrame, total) else 0;
    local count := if IsFrame(args) and IsInteger(args.levels) and args.levels > 0 then Min(args.levels, total - first) else total - first;
    local result := Array(count, nil);
    for i := 0 to count - 1 do
      result[i] := all[first + i];
    :SendResponse(request, {stackFrames: result, totalFrames: total});
  end,

  // Arguments, Locals (with self), and Stack of a frame on the Newton, from
  // the agent (|DAPAgent:Scopes|, one round trip; frames and arrays in them
  // are expanded when the client asks).
  scopes: func(request)
  begin
    local level := if IsInteger(request.arguments.frameId) then request.arguments.frameId - 1;
    local remote := DAPRemote:RemoteScopes(level);
    local scopes := [];
    if IsFrame(remote) then
    begin
      local locals := [];
      if remote.receiver then
        AddArraySlot(locals, ['|self|, remote.receiver]);     // 'self is reserved
      foreach pair in remote.locals do
        AddArraySlot(locals, pair);
      if Length(remote.args) > 0 then
        AddArraySlot(scopes, {name: "Arguments", presentationHint: "arguments",
                              variablesReference: :NewHandle({remoteItems: remote.args}),
                              expensive: nil});
      if Length(locals) > 0 then
        AddArraySlot(scopes, {name: "Locals", presentationHint: "locals",
                              variablesReference: :NewHandle({remoteItems: locals}),
                              expensive: nil});
      if Length(remote.temps) > 0 then
        AddArraySlot(scopes, {name: "Stack", variablesReference: :NewHandle({remoteItems: remote.temps}),
                              expensive: nil});
    end;
    :SendResponse(request, {scopes: scopes});
  end,

  // A scope's variables, or a remote frame's slots or array's elements
  // (|DAPAgent:Expand|, start/count for paging); values evaluated here
  // (a local copy) as in DAP.ns.
  variables: func(request)
  begin
    local args := request.arguments;
    local ref := args.variablesReference;
    local what := if IsInteger(ref) and ref >= 1 and ref <= Length(handles) then handles[ref - 1];
    if not (IsFrame(what) and (HasSlot(what, 'remoteItems) or HasSlot(what, 'remote))) then
      return DAPRequests:variables(request);
    local result := [];
    if HasSlot(what, 'remoteItems) then
      foreach pair in what.remoteItems do
        AddArraySlot(result, DAPRemote:MakeRemoteVariable(pair[0], pair[1],
          if IsSymbol(pair[0]) and :IsIdentifier(SymbolName(pair[0])) then SymbolName(pair[0])
          else if pair[0] = '|self| then "self"))
    else
    begin
      local first := if IsInteger(args.start) then Min(args.start, what.count) else 0;
      local count := if IsInteger(args.count) and args.count > 0 then Min(args.count, what.count - first)
                     else what.count - first;
      local items := DAPRemote:RemoteCall("if HasPath(functions, '|DAPAgent:Expand|) then "
        & "call functions.|DAPAgent:Expand| with (" & what.remote & ", " & first & ", " & count & ")");
      if IsArray(items) then
        foreach pair in items do
          AddArraySlot(result, DAPRemote:MakeRemoteVariable(
            if what.kind = 'array then "[" & pair[0] & "]" else pair[0], pair[1],
            :SubPath(what.path, pair[0])));
    end;
    :SendResponse(request, {variables: result});
  end,

  // Breakpoints in source files (the program's, or the package's), on the
  // Newton through the agent.
  setBreakpoints: func(request)
  begin
    local args := request.arguments;
    local requested := if IsFrame(args) and IsArray(args.breakpoints) then args.breakpoints else [];
    local path := if IsFrame(args) and IsFrame(args.source) then args.source.path;
    local result;
    if IsString(path) then
      result := DAPRemote:SetRemoteBreakpoints(path, requested)
    else
    begin
      result := [];
      foreach bp in requested do
        AddArraySlot(result, {verified: nil, line: bp.line,
                              message: "Only breakpoints in source files work on a remote Newton"});
    end;
    :SendResponse(request, {breakpoints: result});
  end,

  // The filter, also on the Newton (when it doesn't run anything: it only
  // answers when idle)
  setExceptionBreakpoints: func(request)
  begin
    DAPRequests:setExceptionBreakpoints(request);
    if NTKIsConnected() and not DAPRemote.busy then
      DAPRemote:ApplyExceptionFilter();
  end,

  // An expression, compiled here and run on the Newton (when it is stopped
  // or idle): in the stopped frame frameId (its variables, self), else
  // globally. The result as the agent describes it (frames and arrays
  // expand like variables).
  evaluate: func(request)
  begin
    local args := request.arguments;
    if not (IsFrame(args) and IsString(args.expression)) then
      Throw('|evt.ex.msg|, "evaluate: no expression");
    if not NTKIsConnected() then
      Throw('|evt.ex.msg|, "The Newton isn't connected");
    if DAPRemote.busy and DAPRemote.depth = 0 then
      Throw('|evt.ex.msg|, "The Newton is running the program; evaluate when it is stopped");
    local level := if DAPRemote.depth > 0 and IsInteger(args.frameId) and args.frameId >= 1
                      and args.frameId <= Length(DAPRemote:RemoteStackFrames())
                   then args.frameId - 1;
    local variable := DAPRemote:MakeRemoteVariable("", DAPRemote:RemoteEvaluate(args.expression, level), nil);
    :SendResponse(request, {result: variable.value, type: variable.type,
                            variablesReference: variable.variablesReference});
  end,

  disconnect: func(request)
  begin
    DAPRemote:EndSession();
    :SendResponse(request, nil);
    DAPExit(0);
  end,
});
