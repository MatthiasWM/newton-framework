// NS Debug Tools for newtc
//
// The NewtonScript part of Apple's "NS Debug Tools.pkg" 2.2 (1995-1997,
// shipped with NTK 1.6.4 as "Newton Debug Tools 2.2"), decompiled with newtc
// and made readable: names instead of arg0/loc0/Ref_NNN, and comments. The
// logic is Apple's; every change is marked "newtc:". The package-internal
// Ref_NNN names are kept in the comments to find the original code in
// `newtc -pkg "NS Debug Tools.pkg" -decompile`.
//
// The package's ARM code is replaced by C++ functions (Frames/DebugAPI.cc,
// registered by installNSDebugToolsNatives() in newtc.cc): the globals
// NSDInstallBreakPoints, NSDEnableBreakPoints, NSDMakeNSDebugAPI,
// NSDFindSlotName, NSDRefToHexString, and the methods in the global frame
// NSDSelfFuncs.
//
// This file is built into newtc (CMake: embed_newtonscript) and run by
// `newtc -dbg`. See Matt/CLAUDE.md, Phase 3.
//
// How it is organized (like the package):
// - Global constants holding helper functions and data.
// - kNSDStackProto, the "stack object": CurrentStack() clones it and sets
//   its _proto to NSDSelfFuncs (the native debug API methods). Stack frame 0
//   is the oldest. FindBreakLoop() finds the newest BreakLoop frame; the
//   function being debugged at `level` n is at frame FindBreakLoop() - 1 - n.
// - kNSDTools, the library frame: helper methods, and one "maker" per global
//   function. A maker returns the function as a closure, so the function's
//   self is kNSDTools and it can call the helpers. (In the package, NTK had
//   already run the makers at build time.)
// - At the end, the code that defines the global functions.


//------------------------------------------------------------------------------
// Helpers
//------------------------------------------------------------------------------

// Set the global 'trace (NewtonScript function tracing) and return its old
// value. Every debug tool turns tracing off while it runs. Calling a function
// presumably makes the interpreter pick up the new setting. (Ref_414)
DefineGlobalConstant('kNSDSetTrace, func(newTrace)
begin
  local oldTrace := GetGlobalVar('trace);
  DefGlobalVar('trace, newTrace);
  Apply(func() nil, nil);
  return oldTrace;
end);

// The option `name` from the global frame vars.NSDParamFrame, or nil.
// Used: NoInaccWarning. (Ref_573)
DefineGlobalConstant('kNSDParam, func(name)
  HasPath(vars, 'NSDParamFrame)
  and IsInstance(vars.NSDParamFrame, 'frame)
  and vars.NSDParamFrame.(name));


// True if fn was compiled with NTK's "Compile for debugging" option: it has a
// DebuggerInfo array of class 'dbg1 with the names of its variables.
// newtc's compiler does not write DebuggerInfo (yet). (Ref_462)
DefineGlobalConstant('kNSDHasDebugInfo, func(fn)
  HasPath(fn, 'DebuggerInfo) and IsInstance(fn.DebuggerInfo, 'dbg1));


// True for NewtonScript functions (NOS 1 CodeBlock or NOS 2 _function),
// which can be debugged; nil for native functions. (Ref_581)
DefineGlobalConstant('kNSDIsInterpreted, func(fn)
begin
  local fnClass := ClassOf(fn);
  return fnClass = 'CodeBlock or fnClass = '_function;
end);

// True if the view is open. (Ref_664)
DefineGlobalConstant('kNSDIsOpen, func(view)
begin
  if HasVariable(view, 'IsOpen) then
    return view:IsOpen();
  return view.viewCObject <> nil;
end);


//------------------------------------------------------------------------------
// The disassembler (package part 0)
//------------------------------------------------------------------------------

// True if fn may be disassembled: it was compiled with NTK's "Compile for
// debugging" (it has DebuggerInfo), or the global becausePeterSaidSo is set.
// (Ref_261: NewtonScript compiled to ARM by NTK; decoded from its code: it
// calls FrameHasPath(fn, 'DebuggerInfo), then GetFramePath(vars,
// 'becausePeterSaidSo).) newtc -dbg sets becausePeterSaidSo, see the end.
DefineGlobalConstant('kNSDCanDisassemble, func(fn)
  if HasPath(fn, 'DebuggerInfo) or vars.becausePeterSaidSo then true else nil);

// The disassembler object; MakeDisassembler(fn) clones it. (Ref_41)
DefineGlobalConstant('kNSDDisassemblerProto, {
  _proto: {
    // Verbose output: explain each operand in a comment.
    PrintVerbosity: func(verbose)
      fVerbosity := verbose <> nil,

    // Column widths for the instruction name and its operand: an integer, or
    // true for the default (21, 18), or nil for none.
    PrettySpacing: func(instWidth, argWidth)
    begin
      if ClassOf(instWidth) = 'int then
        fInstPad := instWidth
      else if instWidth then
        fInstPad := 21
      else
        fInstPad := 0;
      if ClassOf(argWidth) = 'int then
        fArgPad := argWidth
      else if argWidth then
        fArgPad := 18
      else
        fArgPad := 0;
    end,

    // Print objects on one line, completely, while disassembling.
    PrintStateSave: func()
    begin
      fSavedPrettyPrint := prettyPrint;
      fSavedPrintDepth := printDepth;
      prettyPrint := nil;
      printDepth := -1;
    end,

    PrintStateRestore: func()
    begin
      prettyPrint := fSavedPrettyPrint;
      printDepth := fSavedPrintDepth;
    end,

    // Write str padded with spaces to `width` columns (at least one space);
    // alignRight writes the padding first.
    WriteToWidth: func(str, width, alignRight)
    begin
      local length := StrLen(str) + 1;
      if not alignRight then
        Write(str);
      for i := width to length by -1 do
        Write($ );
      if alignRight then
        Write(str)
      else if width < length then
        Write($ );
    end,

    // Print the instructions from pc `start` to pc `stop`, one per line.
    Disassemble: func(start, stop)
    begin
      try
        local length := Length(fDisasmFn.instructions);
        local pc := 0;
        self:PrintStateSave();
        while pc < length do
        begin
          if start <= pc then
          begin
            if pc > stop then
              break;
            self:WriteToWidth(pc & "", 5, true);
            Write($:);
            Write($ );
            self:PrintInstruction(pc);
            Write($\n);
          end;
          pc := pc + self:InstrLength(pc);
        end;
        self:PrintStateRestore();
      // newtc: the package caught |ex.evt| (sic), which never matches, so the
      // print settings were not restored after an error.
      onexception |evt.ex| do
        self:PrintStateRestore();
    end,

    // Print the instruction at pc (no newline).
    PrintInstruction: func(pc)
    begin
      local opcode := self:InstrOpcode(pc);
      local parameter := self:InstrParameter(pc);
      if opcode = 0 then
        Write(Unary1OpNames[parameter])
      else if opcode = 24 then            // freq-func
      begin
        self:WriteToWidth(OpNames[opcode] & FreqFuncInfo[parameter].name, fInstPad, nil);
        if fVerbosity then
        begin
          self:WriteToWidth(NumberStr(FreqFuncInfo[parameter].numArgs), fArgPad, nil);
          Write("\\\\ primitive function" && parameter & $, && FreqFuncInfo[parameter].numArgs && "arg(s)");
        end
        else
          Write(FreqFuncInfo[parameter].numArgs);
      end
      else if opcode >= Length(OpNames) then
      begin
        if fVerbosity then
        begin
          self:WriteToWidth(NumberStr(parameter), fInstPad + fArgPad, nil);
          Write("\\\\ unrecognized opcode" && parameter);
        end
        else
          Write(opcode);
      end
      else
      begin
        self:WriteToWidth(OpNames[opcode], fInstPad, nil);
        if opcode = 3 then                // push: a literal
        begin
          local literal := fDisasmFn.literals[parameter];
          if IsInstance(literal, 'symbol) then
            Write($' & SPrintObject(literal))
          else
            Display(literal);
        end
        else if opcode = 14 or opcode = 21 then   // find-var, set-find-var: a name
        begin
          if fVerbosity then
          begin
            self:WriteToWidth(SPrintObject(fDisasmFn.literals[parameter]), fArgPad, nil);
            Write("\\\\ literal [" && parameter && $]);
          end
          else
            Display(fDisasmFn.literals[parameter]);
        end
        else if opcode = 4 then           // push-constant: the Ref itself
          Display(Ref(parameter))
        else if opcode = 15 or opcode = 20 or opcode = 22 then  // get-var, set-var, incr-var
        begin
          local name := self:GetArgName(parameter);
          if not IsInstance(name, 'string) then
            name := SPrintObject(name);
          if StrEqual(name, "") then
            name := $[ && parameter && $];
          if fVerbosity then
          begin
            self:WriteToWidth(name, fArgPad, nil);
            Write("\\\\ argument or local [" && parameter && $]);
          end
          else
            Write(name);
        end
        else
          Write(parameter);
      end;
    end,

    GetFindVarName: func(index)
      index < Length(fDisasmFn.literals) and fDisasmFn.literals[index],

    // The name of argument/local `index` (as used by get-var: the first 3
    // are the argFrame's system slots), from the argFrame of NOS 1 code or
    // the DebuggerInfo of NOS 2 code; nil if unknown.
    GetArgName: func(index)
    begin
      if ClassOf(fDisasmFn) = 'CodeBlock then
        return self:GetSlotName(fDisasmFn.argFrame, index);
      if ClassOf(fDisasmFn) = '_function and ClassOf(fDisasmFn.DebuggerInfo) = 'dbg1 then
      begin
        local info := fDisasmFn.DebuggerInfo;
        local name := info[index + info[0] + 1 - 3];
        return if IsInstance(name, 'symbol) then name else info[name];
      end;
      return nil;
    end,

    Unary1OpNames: ["Pop", "Dup", "Return", "PushSelf", "SetLexScope",
                    "IterNext", "IterDone", "PopHandlers"],

    OpNames: ["Unary1", "Unary2", "Unary3", "Push", "PushConstant", "Call",
              "Invoke", "Send", "SendIfDefined", "Resend", "ResendIfDefined",
              "Branch", "BranchIfNotNil", "BranchIfNil", "FindVar", "GetVar",
              "MakeFrame", "MakeArray", "GetPath", "SetPath", "SetVar",
              "SetFindVar", "IncrVar", "BranchIfLoopNotDone", "",
              "NewHandlers"],

    // The frequently used functions called by freq-func n.
    FreqFuncInfo: [
      {name: "Add", numArgs: 2}, {name: "Subtract", numArgs: 2},
      {name: "GetArraySlot", numArgs: 2}, {name: "SetArraySlot", numArgs: 3},
      {name: "Equal", numArgs: 2}, {name: "Not", numArgs: 1},
      {name: "NotEqual", numArgs: 2}, {name: "Multiply", numArgs: 2},
      {name: "Divide", numArgs: 2}, {name: "Div", numArgs: 2},
      {name: "LessThan", numArgs: 2}, {name: "GreaterThan", numArgs: 2},
      {name: "GreaterOrEqual", numArgs: 2}, {name: "LessOrEqual", numArgs: 2},
      {name: "BitAnd", numArgs: 2}, {name: "BitOr", numArgs: 2},
      {name: "BitNot", numArgs: 2}, {name: "NewIterator", numArgs: 2},
      {name: "Length", numArgs: 1}, {name: "Clone", numArgs: 1},
      {name: "SetClass", numArgs: 2}, {name: "AddArraySlot", numArgs: 2},
      {name: "Stringer", numArgs: 1}, {name: "HasPath", numArgs: 2},
      {name: "ClassOf", numArgs: 1}],

    // Decoding: an instruction byte is opcode (5 bits) and a 3-bit parameter;
    // parameter 7 means the real one follows in the next 2 bytes.
    InstrOpcode: func(pc)
      ExtractByte(fDisasmFn.instructions, pc) >> 3,

    InstrParameter: func(pc)
    begin
      if self:HasParm(ExtractByte(fDisasmFn.instructions, pc)) then
      begin
        local opcode := self:InstrOpcode(pc);
        if opcode = 4 or opcode = 17 then   // push-constant, make-array: signed
          return ExtractWord(fDisasmFn.instructions, pc + 1);
        return bOr(ExtractByte(fDisasmFn.instructions, pc + 1) << 8,
                   ExtractByte(fDisasmFn.instructions, pc + 2));
      end;
      return self:ArgSpec(ExtractByte(fDisasmFn.instructions, pc));
    end,

    InstrLength: func(pc)
      if self:HasParm(ExtractByte(fDisasmFn.instructions, pc)) then 3 else 1,

    HasParm: func(byte)
      self:ArgSpec(byte) = 7,

    ArgSpec: func(byte)
      bAnd(byte, 7),

    // The tag of the slot at `index` in `frame`, or nil.
    GetSlotName: func(frame, index)
    begin
      local i := 0;
      foreach tag, value in frame do
        if i = index then
          return tag
        else
          i := i + 1;
      return nil;
    end
  },
  class: 'Disassembler,
  fDisasmFn: nil,
  fVerbosity: true,
  fInstPad: 0,
  fArgPad: 0,
  fSavedPrettyPrint: nil,
  fSavedPrintDepth: nil
});

// MakeDisassembler(fn): a disassembler for the NewtonScript function fn.
// Options come from the global frame vars.NSDParamFrame (DisasmInstWidth,
// DisasmArgWidth, Verbose). (package part 0, Ref_27[0])
DefGlobalFn('MakeDisassembler, func(fn)
begin
  if not call kNSDIsInterpreted with (fn) then
    Throw('|evt.ex.fr.type;type.ref|, {errorCode: -48411, value: fn});
  local disassembler := Clone(kNSDDisassemblerProto);
  disassembler.fDisasmFn := fn;
  if HasPath(vars, 'NSDParamFrame) and IsInstance(vars.NSDParamFrame, 'frame) then
  begin
    local params := vars.NSDParamFrame;
    local instWidth := if HasSlot(params, 'DisasmInstWidth) then params.DisasmInstWidth else true;
    local argWidth := if HasSlot(params, 'DisasmArgWidth) then params.DisasmArgWidth else true;
    disassembler:PrettySpacing(instWidth, argWidth);
    if HasSlot(params, 'Verbose) then
      disassembler:PrintVerbosity(params.Verbose);
  end
  else
  begin
    disassembler:PrintVerbosity(nil);
    disassembler:PrettySpacing(true, true);
  end;
  return disassembler;
end);

// Disasm(fn): print all instructions of fn. (Ref_248)
DefGlobalFn('Disasm, func(fn)
begin
  local oldTrace := call kNSDSetTrace with (nil);
  if not call kNSDIsInterpreted with (fn) then
    Write("ERROR: Disasm( function ) requires an object of class 'CodeBlock or '_function.\n")
  else if not call kNSDCanDisassemble with (fn) then
    Write("ERROR: function not built with \"Compile for debugging\" option; cannot disassemble.\n")
  else
    MakeDisassembler(fn):Disassemble(0, Length(fn.instructions));
  call kNSDSetTrace with (oldTrace);
  return nil;
end);

// DisasmRange(fn, start, stop): print the instructions from pc start to
// pc stop. (Ref_270; written from its bytecode: the decompiled source is
// missing everything after the start check.)
DefGlobalFn('DisasmRange, func(fn, start, stop)
begin
  local oldTrace := call kNSDSetTrace with (nil);
  if not call kNSDIsInterpreted with (fn) then
    Write("ERROR: DisasmRange(function, start, stop) requires a function argument of class 'CodeBlock or '_function.\n")
  else if not call kNSDCanDisassemble with (fn) then
    Write("ERROR: function not built with \"Compile for debugging\" option; cannot disassemble.\n")
  else
  begin
    if start < 0 then
    begin
      Write("WARNING: DisasmRange(function, start, stop) requires a start value greater than 0.\n");
      Write("         Disassembling from 0.\n\n");
      start := 0;
    end;
    if stop > Length(fn.instructions) then
    begin
      Write("WARNING: The stop value you specified is larger than the length of the function.\n");
      Write("         Disassembling to the end of the function.\n\n");
    end;
    MakeDisassembler(fn):Disassemble(start, stop);
  end;
  call kNSDSetTrace with (oldTrace);
  return nil;
end);


//------------------------------------------------------------------------------
// The stack object (Ref_531)
//------------------------------------------------------------------------------

DefineGlobalConstant('kNSDStackProto, {
  _proto: nil,        // CurrentStack() sets this to NSDSelfFuncs
  nsDebugAPI: nil,    // and this to NSDMakeNSDebugAPI()

  // Temporary n of stack frame `frame`, counted from the top: 0 is the value
  // that frame pushed last.
  temporary: func(frame, n)
    self:TempValue(frame, self:NumTemps(frame) - n - 1),

  SetTemporary: func(frame, n, value)
    self:SetTempValue(frame, self:NumTemps(frame) - n - 1, value),

  // The newest BreakLoop frame on the stack. Throws if there is none.
  FindBreakLoop: func()
  begin
    local frame := self:NumStackFrames() - 1;
    while 0 < frame do
      if self:Function(frame) = functions.BreakLoop then
        return frame
      else
        frame := frame - 1;
    Throw('|evt.ex.fr.intrp|, -48800);
  end
});


//------------------------------------------------------------------------------
// The library frame (Ref_427)
//------------------------------------------------------------------------------

DefineGlobalConstant('kNSDTools, {

  //--- Helpers ---

  // A new stack object for the current interpreter, see kNSDStackProto.
  CurrentStack: func()
  begin
    local stack := Clone(kNSDStackProto);
    stack._proto := vars.NSDSelfFuncs;
    stack.nsDebugAPI := self:MakeNSDebugAPI();
    return stack;
  end,

  MakeNSDebugAPI: func()
    NSDMakeNSDebugAPI(),

  EnableBreakPoints: func(enable)
    NSDEnableBreakPoints(enable),

  // Replace the breakpoint frame and return the previous one. Passing nil
  // and then the result back is how the tools read the current frame:
  // {programCounter: [breakpoint, ...]}, or nil if there are none.
  InstallBreakPoints: func(breakPoints)
    NSDInstallBreakPoints(breakPoints),

  // Add a temporary breakpoint: it is removed when it is hit. Used for
  // stepping. Throws if fn is not a NewtonScript function or pc not an int.
  InstallTempBreakPoint: func(fn, pc)
  begin
    if call kNSDIsInterpreted with (fn) and HasPath(fn, 'instructions) then
    begin
      if IsInstance(pc, 'int) then
      begin
        local breakPoints := self:InstallBreakPoints(nil);
        self:InstallBreakPoints(breakPoints);
        local breakPoint := {instructions: fn.instructions, programCounter: pc,
                             temporary: true};
        if breakPoints then
        begin
          if breakPoints.programCounter then
            AddArraySlot(breakPoints.programCounter, breakPoint)
          else
            breakPoints.programCounter := [breakPoint];
        end
        else
          self:InstallBreakPoints({programCounter: [breakPoint]});
      end
      else
        Throw('|evt.ex.fr.type;type.ref|, {errorCode: -48406, value: pc});
    end
    else
      Throw('|evt.ex.fr.type;type.ref|, {errorCode: -48411, value: fn});
    return nil;
  end,

  // Search the _proto chain of `frame` for `slot`. If found, add the slot
  // and the _proto steps to `path` (backwards: slot first) and return true.
  ProtoSlotPath: func(frame, slot, path)
  begin
    if IsInstance(frame, 'frame) and HasSlot(frame, '_proto) then
    begin
      if HasSlot(frame._proto, slot) then
      begin
        AddArraySlot(path, slot);
        AddArraySlot(path, '_proto);
        return true;
      end;
      local found := self:ProtoSlotPath(frame._proto, slot, path);
      if found then
        AddArraySlot(path, '_proto);
      return found;
    end;
    return nil;
  end,

  // Search the _parent chain of `frame` (and the _proto chain of every
  // parent) for `slot`, like ProtoSlotPath.
  ParentSlotPath: func(frame, slot, path)
  begin
    if IsInstance(frame, 'frame) and HasSlot(frame, '_parent) then
    begin
      if HasSlot(frame._parent, slot) then
      begin
        AddArraySlot(path, slot);
        AddArraySlot(path, '_parent);
        return true;
      end;
      local found := self:ProtoSlotPath(frame._parent, slot, path);
      if not found then
        found := self:ParentSlotPath(frame._parent, slot, path);
      if found then
        AddArraySlot(path, '_parent);
      return found;
    end;
    return nil;
  end,

  // True if the PCs on the stack are exact: SetDebugMode(true) is on, or
  // breakpoints are enabled (the interpreter then runs its slow loop).
  StackIsAccurate: func(stack)
  begin
    if stack and stack:AccurateStack() then
      return true;
    local enabled := self:EnableBreakPoints(nil);   // read the setting...
    self:EnableBreakPoints(enabled);                // ...and restore it
    return enabled;
  end,

  //--- Makers of the global functions ---

  // GetCurrentFunction(level): the function at `level` in the break loop;
  // 0 is the one that stopped, 1 its caller, and so on.
  GetCurrentFunction: func()
    func(level)
    begin
      local oldTrace := call kNSDSetTrace with (nil);
      local stack := self:CurrentStack();
      local fn := stack:Function(stack:FindBreakLoop() - 1 - level);
      call kNSDSetTrace with (oldTrace);
      return fn;
    end,

  // GetCurrentPC(level): the PC (the next instruction) of the function at
  // `level` in the break loop. Warns if the PC may not be exact.
  GetCurrentPC: func()
    func(level)
    begin
      local oldTrace := call kNSDSetTrace with (nil);
      local inaccurate := nil;
      local stack := self:CurrentStack();
      if not call kNSDParam with ('NoInaccWarning) then
      begin
        inaccurate := not self:StackIsAccurate(stack);
        if inaccurate then
          Write("WARNING: The PC may not be accurate.\n"
                "         Enable breakpoints for better information.\n\n");
      end;
      local pc := stack:ProgramCounter(stack:FindBreakLoop() - 1 - level);
      call kNSDSetTrace with (oldTrace);
      return pc;
    end,

  // GetCurrentReceiver(level): self of the function at `level`.
  GetCurrentReceiver: func()
    func(level)
    begin
      local oldTrace := call kNSDSetTrace with (nil);
      local stack := self:CurrentStack();
      local receiver := stack:Receiver(stack:FindBreakLoop() - 1 - level);
      call kNSDSetTrace with (oldTrace);
      return receiver;
    end,

  // GetCurrentImplementor(level): where the method at `level` was found in
  // the receiver's _proto/_parent chain.
  GetCurrentImplementor: func()
    func(level)
    begin
      local oldTrace := call kNSDSetTrace with (nil);
      local stack := self:CurrentStack();
      local implementor := stack:Implementor(stack:FindBreakLoop() - 1 - level);
      call kNSDSetTrace with (oldTrace);
      return implementor;
    end,

  // GetTempVar(level, n): temporary n of the function at `level`, counted
  // from the top of its part of the stack (0 = pushed last).
  GetTempVar: func()
    func(level, n)
    begin
      local oldTrace := call kNSDSetTrace with (nil);
      local stack := self:CurrentStack();
      local value := stack:temporary(stack:FindBreakLoop() - 1 - level, n);
      call kNSDSetTrace with (oldTrace);
      return value;
    end,

  // SetTempVar(level, n, value): change temporary n; returns value.
  SetTempVar: func()
    func(level, n, value)
    begin
      local oldTrace := call kNSDSetTrace with (nil);
      local stack := self:CurrentStack();
      stack:SetTemporary(stack:FindBreakLoop() - 1 - level, n, value);
      call kNSDSetTrace with (oldTrace);
      return value;
    end,

  // GetAllTempVars(level): all temporaries of the function at `level`, top
  // first, followed by the symbol 'bottom.
  GetAllTempVars: func()
    func(level)
    begin
      local oldTrace := call kNSDSetTrace with (nil);
      local stack := self:CurrentStack();
      local frame := stack:FindBreakLoop() - 1 - level;
      local count := stack:NumTemps(frame);
      local temps := Array(Max(count + 1, 1), 'bottom);
      for i := 0 to count - 1 do
        temps[i] := stack:temporary(frame, i);
      call kNSDSetTrace with (oldTrace);
      return temps;
    end,

  // GetNamedVar(level, name): the variable `name` of the function at `level`.
  // With DebuggerInfo, the name is looked up there and the variable read by
  // its index; otherwise it is looked up in the frame's lexical environment
  // (FindVar), which only NOS 1 code and closures have.
  GetNamedVar: func()
    func(level, name)
    begin
      local oldTrace := call kNSDSetTrace with (nil);
      local stack := self:CurrentStack();
      local frame := stack:FindBreakLoop() - 1 - level;
      local fn := stack:Function(frame);
      local value;
      if call kNSDHasDebugInfo with (fn) then
      begin
        local info := fn.DebuggerInfo;
        local skip := info[0];     // the names start at info[skip + 1]
        local index := LSearch(info, name, skip + 1, '|=|, nil);
        if IsInstance(index, 'int) then
          value := stack:GetVar(frame, index - skip - 1)
        else
          value := stack:FindVar(frame, name);
      end
      else
        value := stack:FindVar(frame, name);
      call kNSDSetTrace with (oldTrace);
      return value;
    end,

  // SetNamedVar(level, name, value): change the variable `name`, found like
  // GetNamedVar does; returns value.
  SetNamedVar: func()
    func(level, name, value)
    begin
      local oldTrace := call kNSDSetTrace with (nil);
      local stack := self:CurrentStack();
      local frame := stack:FindBreakLoop() - 1 - level;
      local fn := stack:Function(frame);
      if call kNSDHasDebugInfo with (fn) then
      begin
        local info := fn.DebuggerInfo;
        local skip := info[0];
        local index := LSearch(info, name, skip + 1, '|=|, nil);
        if IsInstance(index, 'int) then
          stack:SetVar(frame, index - skip - 1, value)
        else
          stack:SetFindVar(frame, name, value);
      end
      else
        stack:SetFindVar(frame, name, value);
      call kNSDSetTrace with (oldTrace);
      return value;
    end,

  // GetPathToSlot(frame, slot): the path from `frame` to where `slot` is
  // found by inheritance, e.g. _proto._proto.count; an empty path if the
  // slot is not found. The _proto chain is searched first, then _parent.
  GetPathToSlot: func()
    func(frame, slot)
    begin
      local oldTrace := call kNSDSetTrace with (nil);
      local path := SetClass([], 'pathExpr);
      if HasSlot(frame, slot) then
      begin
        AddArraySlot(path, slot);
        call kNSDSetTrace with (oldTrace);
        return path;
      end
      else if not self:ProtoSlotPath(frame, slot, path) then
        self:ParentSlotPath(frame, slot, path);
      // the search built the path backwards: reverse it
      local last := Length(path) - 1;
      for i := 0 to (last + 1) div 2 - 1 do
      begin
        local swap := path[last - i];
        path[last - i] := path[i];
        path[i] := swap;
      end;
      call kNSDSetTrace with (oldTrace);
      return path;
    end,

  // GetPathWhereSet(frame, slot): the path to where `slot := value` in a
  // method of `frame` would store the value. Assigning to a slot inherited
  // through _proto creates it in the frame (or in the last _parent on the
  // way); a slot found through _parent is changed where it is.
  // (Ref_720: in the package a plain function, it does not use self.)
  GetPathWhereSet: func()
    func(frame, slot)
    begin
      local oldTrace := call kNSDSetTrace with (nil);
      local path := GetPathToSlot(frame, slot);
      local length := Length(path);
      if length < 2 then
      begin
        call kNSDSetTrace with (oldTrace);
        return path;
      end;
      for i := length - 1 to 1 by -1 do
        if path[i - 1] = '_parent then
        begin
          path[i] := path[length - 1];    // cut the path after that _parent
          SetLength(path, i + 1);
          break;
        end
        else if i - 1 = 0 then
        begin
          path[i - 1] := path[length - 1];  // no _parent: the frame itself
          SetLength(path, 1);
          break;
        end;
      call kNSDSetTrace with (oldTrace);
      return path;
    end,

  // GetAllNamedVars(level): a frame with all named variables of the function
  // at `level` (from DebuggerInfo, or the argFrame of NOS 1 code). Then every
  // symbol in the function's literals that can be read as a variable is added
  // too; those the receiver doesn't have as a slot are listed in a warning:
  // they are used without being declared (e.g. accidental globals).
  GetAllNamedVars: func()
    func(level)
    begin
      local oldTrace := call kNSDSetTrace with (nil);
      local stack := self:CurrentStack();
      local frame := stack:FindBreakLoop() - 1 - level;
      local fn := stack:Function(frame);
      local namedVars := {};
      if call kNSDHasDebugInfo with (fn) then
      begin
        local info := fn.DebuggerInfo;
        local skip := info[0];
        local count := Length(info) - skip - 1;
        local disassembler := MakeDisassembler(fn);
        for i := 0 to count - 1 do
          namedVars.(disassembler:GetArgName(i + 3)) := stack:GetVar(frame, i);
        local argFrame := fn.argFrame;
        for i := 1 to skip do
        begin
          local name := info[i];
          if not HasPath(namedVars, name) and HasPath(argFrame, name) then
            namedVars.(name) := stack:FindVar(frame, name);
        end;
      end
      else if IsInstance(fn, 'CodeBlock) then
      begin
        namedVars := Clone(fn.argFrame);
        RemoveSlot(namedVars, '_nextArgFrame);
        RemoveSlot(namedVars, '_parent);
        RemoveSlot(namedVars, '_implementor);
        foreach name, value in namedVars do
          namedVars.(name) := stack:FindVar(frame, name);
      end;
      if HasPath(fn, 'literals) and PrimClassOf(fn.literals) = 'Array then
      begin
        local found := [];
        local savedBreakOnThrows := GetGlobals().breakOnThrows;
        GetGlobals().(EnsureInternal('breakOnThrows)) := nil;
        foreach literal in fn.literals do
          if IsInstance(literal, 'symbol) and not HasSlot(namedVars, literal) then
            try
              namedVars.(literal) := stack:FindVar(frame, literal);
              AddArraySlot(found, literal);
            onexception |evt.ex.fr.intrp| do
              nil;
        local warned := nil;
        local receiver := GetCurrentReceiver(level);
        foreach name in found do
        begin
          local undeclared := if receiver then
                                Length(GetPathToSlot(receiver, name)) = 0
                              else
                                true;
          if undeclared then
          begin
            if not warned then
              Write("WARNING: You have not declared the following variables:\n");
            warned := true;
            Write("    " & SPrintObject(name) & $\n);
          end;
        end;
        if warned then
          Write($\n);
        breakOnThrows := savedBreakOnThrows;
      end;
      call kNSDSetTrace with (oldTrace);
      return namedVars;
    end,

  // InstallBreakPoint(fn, pc): stop before the instruction at pc of the
  // NewtonScript function fn. Returns the breakpoint (a frame; pass it to
  // RemoveBreakPoint, EnableBreakPoint, ...). Breakpoints only fire while
  // enabled, see GloballyEnableBreakPoints. A second breakpoint at the same
  // place is added anyway, with a warning.
  InstallBreakPoint: func()
    func(fn, pc)
    begin
      local breakPoint;
      local oldTrace := call kNSDSetTrace with (nil);
      if call kNSDIsInterpreted with (fn) and HasPath(fn, 'instructions) then
      begin
        if IsInstance(pc, 'int) then
        begin
          local breakPoints := self:InstallBreakPoints(nil);
          self:InstallBreakPoints(breakPoints);
          breakPoint := {instructions: fn.instructions, programCounter: pc};
          if breakPoints then
          begin
            if breakPoints.programCounter then
            begin
              local samePlace := func(new, old)
                HasPath(old, 'instructions) and new.instructions = old.instructions
                and HasPath(old, 'programCounter) and new.programCounter = old.programCounter
                and not old.temporary;
              if ArrayPos(breakPoints.programCounter, breakPoint, 0, samePlace) then
                Write("WARNING: Breakpoint already exists!\n");
              AddArraySlot(breakPoints.programCounter, breakPoint);
            end
            else
              breakPoints.programCounter := [breakPoint];
          end
          else
            self:InstallBreakPoints({programCounter: [breakPoint]});
        end
        else
        begin
          call kNSDSetTrace with (oldTrace);
          Throw('|evt.ex.fr.type;type.ref|, {errorCode: -48406, value: pc});
        end;
      end
      else
      begin
        call kNSDSetTrace with (oldTrace);
        Throw('|evt.ex.fr.type;type.ref|, {errorCode: -48411, value: fn});
      end;
      call kNSDSetTrace with (oldTrace);
      return breakPoint;
    end,

  // RemoveBreakPoint(breakPoint): remove one breakpoint.
  RemoveBreakPoint: func()
    func(breakPoint)
    begin
      local oldTrace := call kNSDSetTrace with (nil);
      local breakPoints := self:InstallBreakPoints(nil);
      self:InstallBreakPoints(breakPoints);
      if not (breakPoints and breakPoints.programCounter
              and SetRemove(breakPoints.programCounter, breakPoint)) then
        Print("No such breakpoint exists");
      call kNSDSetTrace with (oldTrace);
      return nil;
    end,

  // RemoveAllBreakPoints(): remove all breakpoints.
  RemoveAllBreakPoints: func()
    func()
    begin
      local oldTrace := call kNSDSetTrace with (nil);
      self:InstallBreakPoints(nil);
      call kNSDSetTrace with (oldTrace);
      return nil;
    end,

  // GetAllBreakPoints(): {programCounter: [breakpoint, ...]}, or nil.
  GetAllBreakPoints: func()
    func()
    begin
      local oldTrace := call kNSDSetTrace with (nil);
      local breakPoints := self:InstallBreakPoints(nil);
      self:InstallBreakPoints(breakPoints);
      call kNSDSetTrace with (oldTrace);
      return breakPoints;
    end,

  // EnableBreakPoint(breakPoint, enableMode): enable the breakpoint if
  // enableMode is non-nil, disable it if nil (NTK documentation). Returns
  // true if it was enabled before.
  // newtc: the package had it backwards (disabled := enableMode <> nil) and
  // returned the previous `disabled` value; changed to match the
  // documentation, and the return value to match. (Ref_733: in the package
  // a plain function, it does not use self.)
  EnableBreakPoint: func()
    func(breakPoint, enableMode)
    begin
      if ClassOf(breakPoint) = 'frame then
      begin
        local wasEnabled := not breakPoint.disabled;
        breakPoint.disabled := enableMode = nil;
        return wasEnabled;
      end;
      return nil;
    end,

  // SetBreakPointLabel(breakPoint, label): attach a label (any object);
  // returns it. (Ref_715: in the package a plain function.)
  SetBreakPointLabel: func()
    func(breakPoint, label)
    begin
      if ClassOf(breakPoint) = 'frame then
      begin
        breakPoint.userLabel := label;
        return label;
      end;
      return nil;
    end,

  // GetBreakPointLabel(breakPoint): its label, or nil. (Ref_499: in the
  // package a plain function.)
  GetBreakPointLabel: func()
    func(breakPoint)
      ClassOf(breakPoint) = 'frame and breakPoint.userLabel,

  // GloballyEnableBreakPoints(flag): turn all breakpoints on or off (the
  // interpreter runs its slow loop while they are on) and return the
  // previous setting. On a Newton, it also updated the NS Debug Tools app.
  GloballyEnableBreakPoints: func()
    func(flag)
    begin
      local oldTrace := call kNSDSetTrace with (nil);
      local wasEnabled := self:EnableBreakPoints(flag <> nil);
      // newtc: no root view without a GUI, so no app to update
      local root := GetRoot();
      local app := root and root.|NS Debug Tools:PIE|;
      local isOpen := app and call kNSDIsOpen with (app);
      if isOpen then
      begin
        app:Close();
        app:Open();
      end
      else if app and GetVariable(app, 'SetExtrasIcon) then
        app:SetExtrasIcon(flag);
      call kNSDSetTrace with (oldTrace);
      return wasEnabled;
    end
});


//------------------------------------------------------------------------------
// Install the global functions
//------------------------------------------------------------------------------

// newtc: newtc's compiler writes no DebuggerInfo, so let Disasm and
// DisasmRange work on all functions (Apple's switch, see kNSDCanDisassemble).
DefGlobalVar('becausePeterSaidSo, true);

foreach name in ['GetCurrentFunction, 'GetCurrentPC, 'GetCurrentReceiver,
                 'GetCurrentImplementor, 'GetTempVar, 'SetTempVar,
                 'GetAllTempVars, 'GetNamedVar, 'SetNamedVar, 'GetAllNamedVars,
                 'GetPathToSlot, 'GetPathWhereSet, 'InstallBreakPoint,
                 'RemoveBreakPoint, 'RemoveAllBreakPoints, 'GetAllBreakPoints,
                 'EnableBreakPoint, 'SetBreakPointLabel, 'GetBreakPointLabel,
                 'GloballyEnableBreakPoints] do
  DefGlobalFn(name, Perform(kNSDTools, name, []));
