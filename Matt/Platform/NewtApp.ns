// NewtApp.ns: `newtc -build app.ns -opkg app.pkg` (plan 4.5). The script only
// says what differs from a sane default; newtc makes the package:
//
//   newtAppName := "Hello:SIG";        // the package's name (required)
//   newtAppSymbol := '|Hello:SIG|;     // the app's symbol (default: the name)
//   newtAppLabel := "Hello";           // its name in Extras (default: the name up to ':')
//   newtAppIcon := MakeIconFromPNG("icon.png");   // the icon in Extras (default: none)
//   newtAppHighlightedIcon := MakeIconFromPNG("highlighted.png");   // when highlighted (optional)
//   newtAppVersion := 1;               // an integer (default 1)
//   newtAppCopyright := "(c) me";      // (default "")
//   newt.theForm := {_proto: protoFloatNGo, ...};   // the app's base view
//   newt.InstallScript := func(partFrame) ...;     // optional, as NTK's
//   newt.RemoveScript := func(removeFrame) ...;    // optional
//
// Once the script has set them, NTK's constants exist for the code after
// that: kAppSymbol, kAppString (its name as a string), kAppName (the label),
// kPackageName. newtc embeds this file; -build calls |newt:Defaults| before
// the script, |newt:Constants| after each of its top-level statements, and
// |newt:Package| at its end (the package frame, for -opkg or -run).

DefGlobalFn('|newt:Defaults|, func()
begin
  DefGlobalVar('newtAppName, nil);
  DefGlobalVar('newtAppSymbol, nil);
  DefGlobalVar('newtAppLabel, nil);
  DefGlobalVar('newtAppIcon, nil);
  DefGlobalVar('newtAppHighlightedIcon, nil);
  DefGlobalVar('newtAppVersion, 1);
  DefGlobalVar('newtAppCopyright, "");
  DefGlobalVar('newt, {
    theForm: {_proto: protoFloatNGo,
              viewBounds: {left: 0, top: 50, right: 200, bottom: 170}},
    InstallScript: nil,
    RemoveScript: nil});
end);

// The app's symbol and label from the globals (with their defaults).
DefGlobalFn('|newt:Symbol|, func()
  if newtAppSymbol then newtAppSymbol
  else if IsString(newtAppName) then Intern(newtAppName));

DefGlobalFn('|newt:Label|, func()
  if newtAppLabel then newtAppLabel
  else if IsString(newtAppName) then
  begin
    local colon := StrPos(newtAppName, ":", 0);
    if colon then SubStr(newtAppName, 0, colon) else newtAppName;
  end);

// kAppSymbol, kAppString, kAppName, kPackageName as the globals are now;
// called after each top-level statement of the script (cheap when nothing
// changed). A constant that changes is defined again: code compiled before
// keeps the old value.
DefGlobalFn('|newt:Constants|, func()
begin
  if not GlobalVarExists('|newt:defined|) then
    DefGlobalVar('|newt:defined|, {});
  local defined := GetGlobalVar('|newt:defined|);   // the values defined so far
  local defineConstant := func(name, value)
    if value and not (defined.(name) and (if IsString(value) then StrEqual(defined.(name), value)
                                           else defined.(name) = value)) then
    begin
      if IsGlobalConstant(name) then
        UndefineGlobalConstant(name);
      DefineGlobalConstant(name, value);
      defined.(name) := value;
    end;
  local symbol := |newt:Symbol|();
  call defineConstant with ('kAppSymbol, symbol);
  call defineConstant with ('kAppString, symbol and SPrintObject(symbol));
  call defineConstant with ('kAppName, |newt:Label|());
  call defineConstant with ('kPackageName, newtAppName);
end);

// The package frame, checked: what -opkg writes.
DefGlobalFn('|newt:Package|, func()
begin
  local buildError := func(message) Throw('|evt.ex.msg|, "-build: " & message);
  if not IsString(newtAppName) or StrLen(newtAppName) = 0 then
    call buildError with ("newtAppName is missing: the package's name, e.g. newtAppName := \"Hello:SIG\";");
  local symbol := |newt:Symbol|();
  if not IsSymbol(symbol) then
    call buildError with ("newtAppSymbol must be a symbol, e.g. newtAppSymbol := '|Hello:SIG|;");
  local label := |newt:Label|();
  if not IsString(label) then
    call buildError with ("newtAppLabel must be a string, e.g. newtAppLabel := \"Hello\";");
  if not IsInteger(newtAppVersion) or newtAppVersion < 0 then
    call buildError with ("newtAppVersion must be an integer, 0 or more");
  local isIcon := func(icon) IsFrame(icon) and IsBinary(icon.bits) and IsFrame(icon.bounds);
  if newtAppIcon and not call isIcon with (newtAppIcon) then
    call buildError with ("newtAppIcon must be an icon, e.g. newtAppIcon := MakeIconFromPNG(\"icon.png\");");
  if newtAppHighlightedIcon and not call isIcon with (newtAppHighlightedIcon) then
    call buildError with ("newtAppHighlightedIcon must be an icon, e.g. MakeIconFromPNG(\"highlighted.png\")");
  if newtAppHighlightedIcon and not newtAppIcon then
    call buildError with ("newtAppHighlightedIcon needs newtAppIcon (the icon when not highlighted)");
  if newtAppHighlightedIcon and (newtAppIcon.bounds.right - newtAppIcon.bounds.left <> newtAppHighlightedIcon.bounds.right - newtAppHighlightedIcon.bounds.left
                             or newtAppIcon.bounds.bottom - newtAppIcon.bounds.top <> newtAppHighlightedIcon.bounds.bottom - newtAppHighlightedIcon.bounds.top) then
    call buildError with ("newtAppIcon and newtAppHighlightedIcon must have the same size");
  if not IsFrame(newt) or not IsFrame(newt.theForm) then
    call buildError with ("newt.theForm must be the app's base view template (a frame)");
  if not StrPos(newtAppName, ":", 0) then
    Print("-build: note: Newton package names are \"Name:Signature\" (e.g. \"Hello:SIG\"), so they stay unique");
  if not StrEqual(SPrintObject(symbol), newtAppName) then
    Print("-build: note: the app symbol " & SPrintObject(symbol) & " differs from the package name " & newtAppName);

  local theForm := newt.theForm;
  if not theForm.appSymbol then
    theForm.appSymbol := symbol;
  local data := {app: symbol, text: label, theForm: theForm};
  if newtAppIcon then
    |newt:Icons|(data, newtAppIcon, newtAppHighlightedIcon);
  if newt.InstallScript then
    data.InstallScript := newt.InstallScript;
  if newt.RemoveScript then
    data.RemoveScript := newt.RemoveScript;
  {
    signature: 'package0,
    id: "xxxx",
    flags: {},
    version: newtAppVersion,
    copyright: newtAppCopyright,
    name: newtAppName,
    info: "newtc",
    part: [{type: "form", flags: {type: 'nos, Notify: true}, info: "newtc -build", data: data}]
  };
end);

// The app's icons in the form part, as NTK's MakeExtrasIcons makes them:
// icon, black and white for every Newton ({bits, mask, bounds}); iconPro,
// for NewtonOS 2.1's Extras, when there are grays or a highlighted version
// ({unhilited, hilited}: Apple's slot names, the Newton reads them; each
// {bounds, bits, mask, colorData: 4-bit and
// 1-bit}). With a highlighted version, icon's mask is the XOR of the two
// black and white images, as NTK's (Extras 2.0 inverts what it covers).
DefGlobalFn('|newt:Icons|, func(data, icon, highlighted)
begin
  local family := func(i)
  begin
    local f := {bounds: i.bounds, bits: i.bits};
    if i.mask then f.mask := i.mask;
    local depths := [];
    if i.colorData then
      foreach entry in i.colorData do AddArraySlot(depths, entry);
    AddArraySlot(depths, {cbits: i.bits, bitDepth: 1});
    f.colorData := depths;
    f;
  end;
  data.icon := {bits: icon.bits, bounds: icon.bounds};
  if highlighted then
    data.icon.mask := XORPixels(highlighted.bits, icon.bits, 'mask)
  else if icon.mask then
    data.icon.mask := icon.mask;
  if icon.colorData or highlighted then
  begin
    data.iconPro := {unhilited: call family with (icon)};
    if highlighted then
      data.iconPro.hilited := call family with (highlighted);
  end;
end);
